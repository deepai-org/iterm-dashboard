ACTIVITY_COLORS = {
    "active": None,  # use default
    "idle": "CLR_ORANGE",
    "stale": "CLR_DIM",
    "zombie": "CLR_RED",
}


def build_session_segments(s, is_last):
    """Build rich text segments for a session line."""
    connector = "\u2514\u2500" if is_last else "\u251C\u2500"
    tty_short = s.tty.replace("/dev/", "")

    # Build display name: prefer foreground command for non-claude sessions
    if s.is_claude:
        name = s.window_name
    elif s.fg_command and s.fg_command not in SHELL_NAMES:
        # Show the foreground command with args
        name = s.fg_command
        if s.fg_args:
            name += " " + s.fg_args
    else:
        name = s.window_name

    if len(name) > NAME_WIDTH:
        name = name[:NAME_WIDTH - 1] + "\u2026"
    padded_name = name.ljust(NAME_WIDTH)
    uptime = format_uptime(s.uptime) if s.uptime else ""
    uptime_secs = parse_etime(s.uptime) if s.uptime else 0

    # Uptime color
    if uptime_secs >= 5 * 86400:
        uptime_clr = CLR_RED
    elif uptime_secs >= 3 * 86400:
        uptime_clr = CLR_ORANGE
    elif uptime_secs >= 1 * 86400:
        uptime_clr = CLR_CYAN
    else:
        uptime_clr = CLR_GREEN

    # Name color based on role and activity
    if s.is_claude:
        name_clr = CLR_PURPLE
    elif s.is_production:
        name_clr = CLR_RED
    elif s.remote_type:
        name_clr = CLR_CYAN
    elif s.activity_state == "zombie":
        name_clr = CLR_RED
    elif s.activity_state == "stale":
        name_clr = CLR_DIM
    else:
        name_clr = CLR_SECONDARY

    segments = [
        (f" {connector} ", MONO_SM, CLR_DIM),
        (padded_name, BOLD_SM if s.is_claude else MONO_SM, name_clr),
    ]

    # Tags section (role, remote, activity)
    tags = []
    if s.remote_type:
        tag = s.remote_type
        if s.remote_target:
            tag += f":{s.remote_target}"
        tags.append(tag)
    if s.is_production:
        tags.append("PROD")
    if s.activity_state in ("idle", "stale", "zombie"):
        if s.activity_state == "idle":
            idle_str = format_age(s.idle_secs)
            tags.append(f"idle {idle_str}")
        else:
            tags.append(s.activity_state)

    if s.is_claude:
        mem_str = format_bytes(s.mem_kb).rjust(5)
        mem_mb = s.mem_kb / 1024
        mem_clr = CLR_RED if mem_mb >= 800 else CLR_ORANGE if mem_mb >= 400 else CLR_GREEN

        cpu_str = f"{s.cpu:.0f}%".rjust(4) if s.cpu >= 1.0 else "    "
        cpu_clr = CLR_RED if s.cpu >= 50 else CLR_ORANGE if s.cpu >= 10 else CLR_DIM

        segments += [
            (" ", MONO_SM, None),
            (mem_str, MONO_SM, mem_clr),
            (" ", MONO_SM, None),
            (cpu_str, MONO_SM, cpu_clr if s.cpu >= 1.0 else CLR_DIM),
        ]
        if tags:
            segments.append((" ", MONO_SM, CLR_DIM))
            segments.append((" ".join(tags), MONO_SM, CLR_ORANGE))
        segments += [
            (" \u2502 ", MONO_SM, CLR_DIM),
            (tty_short, MONO_SM, CLR_DIM),
            (" \u2502 ", MONO_SM, CLR_DIM),
            (uptime, MONO_SM, uptime_clr),
        ]
    else:
        if tags:
            tag_str = " ".join(tags)
            pad = max(1, 12 - len(tag_str))
            segments.append((" " * pad, MONO_SM, CLR_DIM))
            tag_clr = CLR_RED if s.is_production else CLR_ORANGE if "zombie" in tags or "stale" in tags else CLR_CYAN
            segments.append((tag_str, MONO_SM, tag_clr))
            segments.append((" \u2502 ", MONO_SM, CLR_DIM))
        else:
            segments.append(("            \u2502 ", MONO_SM, CLR_DIM))
        segments += [
            (tty_short, MONO_SM, CLR_DIM),
            (" \u2502 ", MONO_SM, CLR_DIM),
            (uptime, MONO_SM, uptime_clr),
        ]

    return segments


def build_project_header_segments(proj_name, gs, warning, role_summary=""):
    """Build rich text segments for a project header."""
    badge = git_badge(gs)
    segments = [
        (f"{proj_name}  ", BOLD, CLR_ACCENT),
    ]

    # Special state gets its own prominent color
    if gs.special_state:
        # Split badge to color special state differently
        segments.append((gs.special_state, BOLD_SM, CLR_RED))
        rest = badge[len(gs.special_state):]
        badge_clr = CLR_RED if gs.conflicts else CLR_ORANGE if gs.dirty > 0 else CLR_GREEN
        segments.append((rest, MONO_SM, badge_clr))
    elif not gs.is_git:
        segments.append((badge, MONO_SM, CLR_DIM))
    elif gs.conflicts:
        segments.append((badge, MONO_SM, CLR_RED))
    elif gs.dirty > 20:
        segments.append((badge, MONO_SM, CLR_RED))
    elif gs.dirty > 0:
        segments.append((badge, MONO_SM, CLR_ORANGE))
    else:
        segments.append((badge, MONO_SM, CLR_GREEN))

    if warning:
        segments.append((f" {warning}", MONO_SM, CLR_RED))

    # Compact role summary
    if role_summary:
        segments.append(("  ", MONO_SM, CLR_DIM))
        segments.append((role_summary, MONO_SM, CLR_DIM))

    return segments


def build_insight_segments(text):
    """Build rich segments for a system insight line."""
    if text.startswith("[!]"):
        return [
            ("[!]", BOLD_SM, CLR_ORANGE),
            (text[3:], MONO_SM, CLR_LABEL),
        ]
    elif text.startswith("[i]"):
        return [
            ("[i]", BOLD_SM, CLR_CYAN),
            (text[3:], MONO_SM, CLR_SECONDARY),
        ]
    return [(text, MONO_SM, CLR_SECONDARY)]


