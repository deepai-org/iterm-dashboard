def get_companion_app_paths():
    """Query companion apps for open file/folder paths.
    Returns dict: {app_name: [path, ...]} for running apps only."""
    result = {}
    ws_apps = {app.bundleIdentifier() for app in NSWorkspace.sharedWorkspace().runningApplications()
               if app.bundleIdentifier()}

    for app_name, info in COMPANION_APPS.items():
        if info["bundle"] not in ws_apps:
            continue
        try:
            # For apps without native AppleScript, use NSAppleScript + System Events
            # (runs in-process so automation permission is prompted for our app)
            if info.get("script") is None:
                se_script = ('tell application "System Events"\n'
                             'set wins to every window of (first process whose bundle identifier is "' + info["bundle"] + '")\n'
                             'set out to ""\n'
                             'repeat with w in wins\n'
                             'set out to out & name of w & linefeed\n'
                             'end repeat\nreturn out\nend tell')
                from Foundation import NSAppleScript
                script_obj = NSAppleScript.alloc().initWithSource_(se_script)
                result_desc, error_info = script_obj.executeAndReturnError_(None)
                raw = result_desc.stringValue() if result_desc else ""
                _clog("Companion %s (NSAppleScript): len=%d err=%s" % (app_name, len(raw) if raw else 0, error_info))
                if raw and raw.strip():
                    lines = [l.strip() for l in raw.splitlines() if l.strip()]
                    parse_mode = info.get("parse", "posix")
                    if parse_mode == "window_title":
                        project_names = set()
                        for title in lines:
                            parts = title.split(" \u2013 ")
                            if len(parts) < 2:
                                parts = title.split(" - ")
                            if parts:
                                project_names.add(parts[0].strip())
                        result[app_name] = list(project_names)
                    else:
                        result[app_name] = lines
                continue

            out = subprocess.run(
                ["osascript", "-e", info["script"]],
                capture_output=True, text=True, timeout=10,
            )
            _clog("Companion %s: rc=%d stdout=%d bytes stderr=%s" %
                  (app_name, out.returncode, len(out.stdout), out.stderr.strip()[:200]))
            if out.returncode != 0:
                continue
            raw = out.stdout.strip()
            if not raw:
                _clog("Companion %s: empty output" % app_name)
                continue

            lines = [l.strip() for l in raw.splitlines() if l.strip()]
            parse_mode = info.get("parse", "posix")

            if parse_mode == "hfs_lines":
                # Convert HFS paths (Macintosh HD:Users:...) to POSIX
                posix_paths = []
                for hfs in lines:
                    # Strip volume prefix, replace colons with slashes
                    parts = hfs.split(":", 1)
                    if len(parts) == 2:
                        posix_paths.append("/" + parts[1].replace(":", "/"))
                result[app_name] = posix_paths
            elif parse_mode == "window_title":
                # PyCharm titles: "project_name – filename.py"
                project_names = set()
                for title in lines:
                    parts = title.split(" \u2013 ")
                    if len(parts) < 2:
                        parts = title.split(" - ")
                    if parts:
                        project_names.add(parts[0].strip())
                result[app_name] = list(project_names)
            else:
                result[app_name] = lines
        except Exception as e:
            _clog("Companion %s: exception %s" % (app_name, str(e)))
            continue
    _clog("Companion results: %s" % str({k: len(v) for k, v in result.items()}))
    return result


def match_apps_to_projects(companion_paths, project_paths):
    """Match companion app paths to project directories.
    Returns dict: {project_path: [app_name, ...]}"""
    matches = defaultdict(set)
    for app_name, paths in companion_paths.items():
        info = COMPANION_APPS[app_name]
        for path in paths:
            norm_path = path.rstrip("/")
            if info.get("parse") == "window_title":
                # Match PyCharm project name against project directory basename
                for proj_path in project_paths:
                    proj_name = os.path.basename(proj_path)
                    if norm_path.lower() == proj_name.lower():
                        matches[proj_path].add(app_name)
            else:
                # Match file/folder path against project directories
                for proj_path in project_paths:
                    if norm_path.startswith(proj_path + "/") or norm_path == proj_path.rstrip("/"):
                        matches[proj_path].add(app_name)
    result = {k: sorted(v) for k, v in matches.items()}
    _clog("Match results: %s" % str(result))
    return result


@dataclass
class ClaudeSession:
    """A resumable Claude Code session from history."""
    session_id: str
    project_path: str
    summary: str
    timestamp: float
    size_kb: int = 0


def _resolve_claude_project_key(key):
    """Resolve a Claude project dir name like '-Users-kevin-Desktop-foo' to a real path.

    Uses recursive backtracking: split on '-' and try grouping consecutive segments
    into directory names joined by '-' or '_', checking the filesystem at each step.
    """
    segments = key.lstrip("-").split("-")

    def _solve(idx, parent):
        if idx >= len(segments):
            return parent
        # Try consuming 1, 2, 3, ... consecutive segments as one directory name
        for length in range(1, len(segments) - idx + 1):
            chunk = segments[idx:idx + length]
            is_last_chunk = (idx + length == len(segments))
            # Try different joiners between segments in this chunk
            if length == 1:
                candidates = [chunk[0]]
            else:
                # Generate all joiner combinations for this chunk (- and _)
                # For efficiency, only try up to 3 segments; beyond that just use -
                if length <= 3:
                    joiners_combos = list(product("-_", repeat=length - 1))
                else:
                    joiners_combos = [("-",) * (length - 1), ("_",) * (length - 1)]
                candidates = []
                for joiners in joiners_combos:
                    name = chunk[0]
                    for j, seg in zip(joiners, chunk[1:]):
                        name += j + seg
                    candidates.append(name)

            for name in candidates:
                full = os.path.join(parent, name)
                if os.path.isdir(full):
                    result = _solve(idx + length, full)
                    if result:
                        return result
            # Last chunk: accept best guess even if dir doesn't exist
            if is_last_chunk:
                return os.path.join(parent, candidates[0])
        return None

    return _solve(0, "/") or ("/" + key.lstrip("-").replace("-", "/"))


def get_claude_sessions(max_per_project=6):
    """Scan ~/.claude/projects/ for resumable Claude Code sessions.

    Returns dict: {resolved_project_path: [ClaudeSession, ...]}
    sorted by most recent first, up to max_per_project per project.
    """
    import glob as glob_mod
    base = os.path.expanduser("~/.claude/projects")
    if not os.path.isdir(base):
        return {}

    result = {}
    for proj_dir in os.listdir(base):
        proj_path_full = os.path.join(base, proj_dir)
        if not os.path.isdir(proj_path_full):
            continue

        jsonls = glob_mod.glob(os.path.join(proj_path_full, "*.jsonl"))
        if not jsonls:
            continue

        # Resolve the project directory name to a real filesystem path
        real_path = _resolve_claude_project_key(proj_dir)
        if not os.path.isdir(real_path):
            continue

        # Collect session info, sorted by most recent
        sess_infos = []
        for f in jsonls:
            sid = os.path.basename(f).replace(".jsonl", "")
            mtime = os.path.getmtime(f)
            size_kb = os.path.getsize(f) // 1024

            # Extract summary: skip boilerplate, find first real user message
            # Also grab the last assistant text as fallback context
            summary = ""
            last_assistant_text = ""
            _skip_prefixes = (
                "[Request interrupted",
                "This session is being continued",
                "<local-command-caveat>",
            )
            try:
                with open(f) as fh:
                    for line in fh:
                        d = json.loads(line)
                        msg = d.get("message", {})
                        role = msg.get("role", "")
                        content = msg.get("content", "")
                        text = ""
                        if isinstance(content, list):
                            for c in content:
                                if isinstance(c, dict) and c.get("type") == "text":
                                    text = c["text"].strip()
                                    break
                        elif isinstance(content, str):
                            text = content.strip()
                        if not text:
                            continue
                        if role == "assistant":
                            last_assistant_text = text
                        if role == "user":
                            if any(text.startswith(p) for p in _skip_prefixes):
                                continue
                            # Found a real user message
                            # If it's a plan, extract the plan title
                            if text.startswith("Implement the following plan:"):
                                for tline in text.split("\n"):
                                    tline = tline.strip().lstrip("#").strip()
                                    if tline and tline != "Implement the following plan:":
                                        summary = tline
                                        break
                            else:
                                summary = text.split("\n")[0]
                            break
            except Exception:
                pass

            # Fallback: use last assistant message if no good user message found
            if not summary and last_assistant_text:
                summary = last_assistant_text.split("\n")[0]

            # Truncate to max 80 chars
            summary = summary[:80]

            sess_infos.append(ClaudeSession(
                session_id=sid,
                project_path=real_path,
                summary=summary or "(no summary)",
                timestamp=mtime,
                size_kb=size_kb,
            ))

        sess_infos.sort(key=lambda s: -s.timestamp)
        result[real_path] = sess_infos[:max_per_project]

    return result


def resume_claude_session(session_id, project_path):
    """Open a new iTerm2 window in the project directory and resume a Claude session."""
    from Foundation import NSAppleScript
    escaped_path = project_path.replace('"', '\\"')
    escaped_sid = session_id.replace('"', '\\"')
    script = NSAppleScript.alloc().initWithSource_(f'''
tell application "iTerm2"
    activate
    set newWindow to (create window with default profile)
    tell current session of newWindow
        write text "cd \\"{escaped_path}\\" && claude --resume \\"{escaped_sid}\\""
    end tell
end tell''')
    script.executeAndReturnError_(None)


def cleanup_devvm_dead_sessions(session_names, vm_name):
    """Kill dead ET sessions on a dev VM."""
    vm_arg = vm_name if vm_name != "default" else None
    for name in session_names:
        _devvm_cmd("et", "--kill", name, vm=vm_arg, timeout=10)


def connect_devvm_session(session_name, vm_name):
    """Open a new iTerm2 window and connect to a dev-vm ET session."""
    from Foundation import NSAppleScript
    escaped_name = session_name.replace('"', '\\"')
    vm_flag = ""
    if vm_name and vm_name != "default":
        escaped_vm = vm_name.replace('"', '\\"')
        vm_flag = f' --vm \\"{escaped_vm}\\"'
    script = NSAppleScript.alloc().initWithSource_(f'''
tell application "iTerm2"
    activate
    set newWindow to (create window with default profile)
    tell current session of newWindow
        write text "cd ~/Desktop/ml_made_fun && ./dev-vm{vm_flag} et \\"{escaped_name}\\""
    end tell
end tell''')
    script.executeAndReturnError_(None)


def collect_menu_data(prev_snapshot=None):
    """Collect all data. Returns (data, session_map, project_window_map, snapshot)."""
    sessions = get_iterm_sessions()
    # Also query Nexus if it's running (check first to avoid AppleScript relaunching it)
    try:
        running = subprocess.run(
            ["osascript", "-e", 'application "Nexus" is running'],
            capture_output=True, text=True, timeout=2,
        )
        if running.stdout.strip() == "true":
            nexus_sessions = get_nexus_sessions()
            sessions.extend(nexus_sessions)
    except Exception:
        pass
    # Also query Terminal.app if it's running
    try:
        running = subprocess.run(
            ["osascript", "-e", 'application "Terminal" is running'],
            capture_output=True, text=True, timeout=2,
        )
        if running.stdout.strip() == "true":
            terminal_sessions = get_terminal_sessions()
            sessions.extend(terminal_sessions)
    except Exception:
        pass
    if sessions:
        enrich_sessions(sessions)

    # ── Dev VM integration ──
    devvm_list = get_devvm_info()
    devvm_ip_map = {}  # ip -> DevVmInfo
    for vm in devvm_list:
        if vm.ip:
            devvm_ip_map[vm.ip] = vm
    # Correlate iTerm sessions with dev VMs by IP match
    # Also collect locally-observed attached session names to correct stale API data
    local_attached = {}  # vm_ip -> set of session names seen in local iTerm process tree
    # Map (vm_ip, session_name) -> (window_id, app_source) for raise-to-front
    local_et_windows = {}
    for s in (sessions or []):
        if s.remote_type in ("et", "ssh") and s.remote_target:
            vm = devvm_ip_map.get(s.remote_target)
            if vm:
                s.devvm_name = vm.vm_name
                # If we got an ET session name from base64, use it for display
                if s.devvm_session_name:
                    local_attached.setdefault(vm.ip, set()).add(s.devvm_session_name)
                    local_et_windows[(vm.ip, s.devvm_session_name)] = (s.window_id, s.app_source)
                    s.remote_target = s.devvm_session_name

    # Override stale API status with local evidence: if we see a live iTerm et
    # session matched to a VM session, it's attached (even if et --list timed out
    # or SSH check failed on slow network)
    for vm in devvm_list:
        attached_names = local_attached.get(vm.ip, set())
        if not attached_names:
            continue
        existing_names = {s.name for s in vm.sessions}
        for vs in vm.sessions:
            if vs.name in attached_names:
                vs.status = "attached"
                vs.clients = max(vs.clients, 1)
                vs.on_remote = True
        # Add sessions we see locally but that et --list didn't return
        # (e.g., API timed out entirely, or S3 has no record yet)
        for name in attached_names - existing_names:
            vm.sessions.append(DevVmSession(
                name=name, status="attached", clients=1, on_remote=True,
            ))

    home = os.path.expanduser("~")
    projects = defaultdict(list)  # keyed by git_root or cwd
    unassigned = []
    git_root_cache = {}  # cwd -> git_root or None

    for s in (sessions or []):
        if not s.cwd or s.cwd == home:
            unassigned.append(s)
        else:
            cwd = s.cwd
            if cwd not in git_root_cache:
                git_root_cache[cwd] = find_git_root(cwd)
            root = git_root_cache[cwd] or cwd
            projects[root].append(s)

    # Query companion apps early so we can add terminal-less projects
    companion_paths = get_companion_app_paths()
    companion_only_apps = defaultdict(set)  # project_path -> {app_names}
    _companion_git_cache = {}  # dir_path -> git_root or None

    def _cached_git_root(dir_path):
        if dir_path not in _companion_git_cache:
            _companion_git_cache[dir_path] = find_git_root(dir_path)
        return _companion_git_cache[dir_path]

    # Process Finder first (folder paths, quick), then others
    for app_name in ["Finder", "BBEdit", "PyCharm"]:
        if app_name not in companion_paths:
            continue
        paths = companion_paths[app_name]
        info = COMPANION_APPS[app_name]

        if info.get("parse") == "window_title":
            # PyCharm: match project name against existing projects first
            for path in paths:
                matched = False
                for proj_path in list(projects.keys()):
                    if path.lower() == os.path.basename(proj_path).lower():
                        matched = True
                        break
                if matched:
                    continue
                # Try to find project dir by scanning common locations
                for parent in [home + "/Desktop", home + "/Documents", home + "/Projects", home + "/dev", home]:
                    candidate = os.path.join(parent, path)
                    if os.path.isdir(candidate):
                        git_root = _cached_git_root(candidate)
                        proj = git_root or candidate
                        if proj not in projects:
                            projects[proj]  # ensure key exists with empty list
                        companion_only_apps[proj].add(app_name)
                        break
        else:
            # Finder / BBEdit: resolve git root from the path
            # Deduplicate directories to avoid redundant git root lookups
            seen_dirs = set()
            for path in paths:
                check_path = path.rstrip("/") if os.path.isdir(path) else os.path.dirname(path)
                if check_path in seen_dirs:
                    continue
                seen_dirs.add(check_path)
                if not os.path.exists(check_path):
                    continue
                git_root = _cached_git_root(check_path)
                if git_root:
                    if git_root not in projects:
                        projects[git_root]  # ensure key exists with empty list
                    companion_only_apps[git_root].add(app_name)

    # Scan Claude Code session history — adds projects and resumable sessions
    claude_sessions_by_project = get_claude_sessions(max_per_project=6)
    for proj_path in claude_sessions_by_project:
        git_root = find_git_root(proj_path) or proj_path
        if git_root not in projects:
            projects[git_root]  # ensure key exists with empty list

    # Filter out sessions that are already active in a terminal
    active_claude_projects = set()
    for s in (sessions or []):
        if s.is_claude and s.cwd:
            root = git_root_cache.get(s.cwd) or find_git_root(s.cwd) or s.cwd
            active_claude_projects.add(root)

    # Build resumable sessions map (keyed by git root, excluding active ones)
    resumable_sessions = {}  # project_path -> [ClaudeSession, ...]
    for proj_path, cs_list in claude_sessions_by_project.items():
        git_root = find_git_root(proj_path) or proj_path
        # The most recent session in an active project is likely the running one — skip it
        if git_root in active_claude_projects and cs_list:
            filtered = cs_list[1:]  # skip the most recent (likely active)
        else:
            filtered = cs_list
        if filtered:
            resumable_sessions[git_root] = filtered

    if not sessions and not projects:
        return None, {}, {}, None

    def oldest_session_age(sess_list):
        max_age = 0
        for s in sess_list:
            if s.uptime:
                age = parse_etime(s.uptime)
                if age > max_age:
                    max_age = age
        return max_age

    sorted_projects = sorted(projects.items(), key=lambda x: -oldest_session_age(x[1]))

    git_statuses = {}
    for path, _ in sorted_projects:
        git_statuses[path] = get_git_status(path)

    total_claude = 0
    total_claude_mem = 0
    total_lsp = 0
    old_claude = []
    stale_sessions = []
    zombie_sessions = []
    remote_sessions = []
    prod_sessions = []

    for s in (sessions or []):
        if s.is_claude:
            total_claude += 1
            total_claude_mem += s.mem_kb
            if s.uptime and parse_etime(s.uptime) > 5 * 86400:
                old_claude.append(s)
        if s.running_command == "sourcekit-lsp":
            total_lsp += 1
        if s.activity_state == "stale":
            stale_sessions.append(s)
        if s.activity_state == "zombie":
            zombie_sessions.append(s)
        if s.remote_type:
            remote_sessions.append(s)
        if s.is_production:
            prod_sessions.append(s)

    # Build snapshot and compute deltas
    snapshot = _compute_snapshot(sessions or [], sorted_projects, git_statuses, total_claude, total_claude_mem)
    deltas = _compute_deltas(prev_snapshot, snapshot, sorted_projects, git_statuses)

    # Match companion apps to projects (companion_paths already queried above)
    project_paths = [path for path, _ in sorted_projects]
    project_apps = match_apps_to_projects(companion_paths, project_paths)
    # Merge in companion-only app associations
    for proj_path, apps in companion_only_apps.items():
        if proj_path in project_apps:
            project_apps[proj_path] = sorted(set(project_apps[proj_path]) | apps)
        else:
            project_apps[proj_path] = sorted(apps)

    data = {
        "projects": [],
        "unassigned": [],
        "insights": [],
        "deltas": deltas,
        "summary_segments": [],
        "devvms": devvm_list,
        "devvm_et_windows": local_et_windows,
    }

    session_map = {}
    project_window_map = {}
    tag_counter = 1000

    for proj_path, sess_list in sorted_projects:
        gs = git_statuses[proj_path]
        proj_name = os.path.basename(proj_path)
        warning = "\u26A0\uFE0F" if gs.dirty > 20 else ""
        if gs.conflicts:
            warning = "\u26A0\uFE0F CONFLICTS"

        role_summary = _build_role_summary(sess_list)

        proj_tag = tag_counter
        tag_counter += 1
        proj_app = sess_list[0].app_source if sess_list else "Finder"
        proj_window_ids = [s.window_id for s in sess_list]
        project_window_map[proj_tag] = (proj_window_ids, proj_app)

        # Group sessions by sub-project (relative path within the git root)
        subdir_groups = defaultdict(list)
        for s in sess_list:
            if s.cwd and s.cwd != proj_path:
                rel = os.path.relpath(s.cwd, proj_path)
                # Only use the first path component as the sub-project name
                subdir_name = rel.split(os.sep)[0]
            else:
                subdir_name = "."
            subdir_groups[subdir_name].append(s)

        has_subdirs = len(subdir_groups) > 1 or (len(subdir_groups) == 1 and "." not in subdir_groups)

        # Sort subdirs: "." first, then alphabetically
        sorted_subdirs = sorted(subdir_groups.keys(), key=lambda k: ("" if k == "." else k))

        def _sort_sessions(sess_group):
            claude_s = []
            named_s = []
            shell_s = []
            for s in sess_group:
                sname_lower = s.window_name.lower()
                if s.is_claude:
                    claude_s.append(s)
                elif re.match(r'^default\s*\(', sname_lower) or sname_lower.startswith("(-bash") or sname_lower.startswith("(-zsh"):
                    shell_s.append(s)
                else:
                    named_s.append(s)
            def session_age(s):
                return parse_etime(s.uptime) if s.uptime else 0
            claude_s.sort(key=session_age)
            named_s.sort(key=session_age)
            shell_s.sort(key=session_age)
            return claude_s + named_s + shell_s

        all_display = []
        subheader_positions = {}  # index -> subdir_name
        in_subgroup_indices = set()  # indices of sessions under a subheader

        for subdir_name in sorted_subdirs:
            group = subdir_groups[subdir_name]
            sorted_group = _sort_sessions(group)
            start_idx = len(all_display)
            if has_subdirs and subdir_name != ".":
                sub_tag = tag_counter
                tag_counter += 1
                sub_app = sorted_group[0].app_source if sorted_group else proj_app
                sub_window_ids = list(set(s.window_id for s in sorted_group))
                project_window_map[sub_tag] = (sub_window_ids, sub_app)
                subheader_positions[start_idx] = (subdir_name, sub_tag, subdir_name)
                for j in range(len(sorted_group)):
                    in_subgroup_indices.add(start_idx + j)
            elif has_subdirs and subdir_name == ".":
                sub_tag = tag_counter
                tag_counter += 1
                sub_app = sorted_group[0].app_source if sorted_group else proj_app
                sub_window_ids = list(set(s.window_id for s in sorted_group))
                project_window_map[sub_tag] = (sub_window_ids, sub_app)
                subheader_positions[start_idx] = (proj_name, sub_tag, ".")
                for j in range(len(sorted_group)):
                    in_subgroup_indices.add(start_idx + j)
            all_display.extend(sorted_group)

        claude_count = sum(1 for s in all_display if s.is_claude)

        session_entries = []
        for i, s in enumerate(all_display):
            # Insert sub-header if needed
            if i in subheader_positions:
                sh_name, sh_tag, sh_subdir = subheader_positions[i]
                sh_path = proj_path if sh_subdir == "." else os.path.join(proj_path, sh_subdir)
                session_entries.append({
                    "type": "subheader",
                    "name": sh_name,
                    "tag": sh_tag,
                    "path": sh_path,
                })

            is_last = (i == len(all_display) - 1)
            # Check if this is the last session in its subdir group
            next_is_subheader = (i + 1) in subheader_positions
            is_last_in_group = is_last or next_is_subheader
            segments = build_session_segments(s, is_last_in_group)
            s_tag = tag_counter
            tag_counter += 1
            session_map[s_tag] = (s.window_id, s.app_source, s.cwd)

            # Build rich tooltip
            proc_names = [p["cmd"].split()[0] for p in s.processes
                          if not any(skip in p["cmd"] for skip in ["login", "-bash", "-zsh"])]
            tooltip = f"Path: {s.cwd}\nProfile: {s.profile}\nSize: {s.columns}x{s.rows}"
            tooltip += f"\nRole: {s.role}"
            tooltip += f"\nState: {s.activity_state}"
            if s.fg_command:
                tooltip += f"\nForeground: {s.fg_command} {s.fg_args}"
            if s.remote_type:
                tooltip += f"\nRemote: {s.remote_type} {s.remote_target}"
            if s.devvm_name:
                tooltip += f"\nDev VM: {s.devvm_name}"
                if s.devvm_session_name:
                    tooltip += f" (session: {s.devvm_session_name})"
            if s.idle_secs > 60:
                tooltip += f"\nIdle: {format_age(s.idle_secs)}"
            if proc_names:
                tooltip += f"\nProcesses: {', '.join(proc_names[:5])}"
            if s.is_claude:
                tooltip += f"\nMemory: {format_bytes(s.mem_kb)}  CPU: {s.cpu}%"

            # Choose icon based on role
            icon_name = ROLE_ICONS.get(s.role, "apple.terminal.fill")
            if s.is_claude:
                icon_color = CLR_PURPLE
            elif s.is_production:
                icon_color = CLR_RED
            elif s.remote_type:
                icon_color = CLR_CYAN
            elif s.activity_state in ("stale", "zombie"):
                icon_color = CLR_DIM
            else:
                icon_color = CLR_SECONDARY

            session_entries.append({
                "type": "session",
                "segments": segments,
                "tag": s_tag,
                "is_claude": s.is_claude,
                "tooltip": tooltip,
                "icon_name": icon_name,
                "icon_color": icon_color,
                "in_subgroup": i in in_subgroup_indices,
            })

        data["projects"].append({
            "header_segments": build_project_header_segments(proj_name, warning, role_summary),
            "git_segments": build_git_status_segments(gs),
            "tag": proj_tag,
            "sessions": session_entries,
            "path": proj_path,
            "session_count": len(all_display),
            "claude_count": claude_count,
            "companion_apps": project_apps.get(proj_path, []),
            "resumable": resumable_sessions.get(proj_path, []),
        })

    for i, s in enumerate(unassigned):
        is_last = (i == len(unassigned) - 1)
        segments = build_session_segments(s, is_last)
        s_tag = tag_counter
        tag_counter += 1
        session_map[s_tag] = (s.window_id, s.app_source)
        tooltip = f"Path: {s.cwd or '~'}\nProfile: {s.profile}\nSize: {s.columns}x{s.rows}"
        tooltip += f"\nRole: {s.role}\nState: {s.activity_state}"
        if s.fg_command:
            tooltip += f"\nForeground: {s.fg_command} {s.fg_args}"

        icon_name = ROLE_ICONS.get(s.role, "apple.terminal.fill")
        icon_color = CLR_PURPLE if s.is_claude else CLR_SECONDARY

        data["unassigned"].append({
            "segments": segments,
            "tag": s_tag,
            "is_claude": s.is_claude,
            "tooltip": tooltip,
            "icon_name": icon_name,
            "icon_color": icon_color,
        })

    # ── System Insights ──
    total_mem_str = format_bytes(total_claude_mem)
    data["insights"].append(f"[!] {total_claude} Claude instances (~{total_mem_str} RAM)")

    # Git-related insights
    for proj_path, sess_list in sorted_projects:
        gs = git_statuses[proj_path]
        proj_name = os.path.basename(proj_path)

        if gs.special_state:
            data["insights"].append(f"[!] {proj_name}: {gs.special_state} in progress")
        if gs.conflicts:
            data["insights"].append(f"[!] {proj_name}: {gs.conflicts} merge conflicts")
        if gs.detached:
            data["insights"].append(f"[!] {proj_name}: detached HEAD")

        for s in sess_list:
            if s.mem_kb > 500 * 1024:
                data["insights"].append(f"[!] {proj_name}: {format_bytes(s.mem_kb)} ({s.window_name})")
        if gs.dirty > 15:
            data["insights"].append(f"[!] {proj_name}: {gs.dirty} dirty files ({gs.untracked} untracked)")
        if gs.ahead > 3:
            data["insights"].append(f"[!] {proj_name}: {gs.ahead} unpushed commits")
        if gs.stashes:
            data["insights"].append(f"[i] {proj_name}: {gs.stashes} stash{'es' if gs.stashes > 1 else ''}")

    # Session health insights
    if prod_sessions:
        hosts = [s.remote_target or s.remote_type for s in prod_sessions]
        data["insights"].append(f"[!] {len(prod_sessions)} production session{'s' if len(prod_sessions) > 1 else ''}: {', '.join(hosts)}")
    if remote_sessions:
        data["insights"].append(f"[i] {len(remote_sessions)} remote session{'s' if len(remote_sessions) > 1 else ''} open")
    if stale_sessions:
        data["insights"].append(f"[i] {len(stale_sessions)} stale session{'s' if len(stale_sessions) > 1 else ''} (>30m idle)")
    if zombie_sessions:
        data["insights"].append(f"[!] {len(zombie_sessions)} zombie session{'s' if len(zombie_sessions) > 1 else ''}")
    if total_lsp:
        data["insights"].append(f"[i] {total_lsp} Swift LSP servers active")
    if old_claude:
        data["insights"].append(f"[i] {len(old_claude)} Claude instances >5d old")

    # Dev VM insights
    for vm in devvm_list:
        vm_label = vm.vm_name if vm.vm_name != "default" else "Dev VM"
        if vm.state == "running":
            detached = [s for s in vm.sessions if s.status == "detached"]
            dead = [s for s in vm.sessions if s.status == "dead"]
            if detached:
                names = ", ".join(s.name for s in detached)
                data["insights"].append(f"[i] {vm_label}: {len(detached)} detached session{'s' if len(detached) > 1 else ''} ({names})")
            if dead:
                data["insights"].append(f"[!] {vm_label}: {len(dead)} dead session{'s' if len(dead) > 1 else ''}")
        elif vm.state == "stopped":
            data["insights"].append(f"[i] {vm_label}: stopped ({vm.instance_type})")

    # Detect repos with multiple sub-project dirs open
    for proj_path, sess_list in sorted_projects:
        subdirs = set()
        for s in sess_list:
            if s.cwd and s.cwd != proj_path:
                rel = os.path.relpath(s.cwd, proj_path).split(os.sep)[0]
                subdirs.add(rel)
        if len(subdirs) > 1:
            data["insights"].append(f"[i] {os.path.basename(proj_path)}: {len(subdirs)} sub-projects active")

    shell_count = sum(1 for s in (sessions or []) if s.role == "shell")
    remote_count = len(remote_sessions)
    data["summary_segments"] = [
        (f"{len(sessions or [])}", BOLD_SM, CLR_ACCENT),
        (" win ", MONO_SM, CLR_DIM),
        ("\u2502", MONO_SM, CLR_DIM),
        (f" {total_claude}", BOLD_SM, CLR_PURPLE),
        (" agent ", MONO_SM, CLR_DIM),
        ("\u2502", MONO_SM, CLR_DIM),
        (f" {shell_count}", BOLD_SM, CLR_SECONDARY),
        (" shell ", MONO_SM, CLR_DIM),
    ]
    if remote_count:
        data["summary_segments"] += [
            ("\u2502", MONO_SM, CLR_DIM),
            (f" {remote_count}", BOLD_SM, CLR_ACCENT),
            (" remote ", MONO_SM, CLR_DIM),
        ]
    if total_lsp:
        data["summary_segments"] += [
            ("\u2502", MONO_SM, CLR_DIM),
            (f" {total_lsp}", BOLD_SM, CLR_ACCENT),
            (" LSP", MONO_SM, CLR_DIM),
        ]
    running_vms = [vm for vm in devvm_list if vm.state == "running"]
    if running_vms:
        data["summary_segments"] += [
            ("\u2502", MONO_SM, CLR_DIM),
            (f" {len(running_vms)}", BOLD_SM, CLR_CYAN),
            (" VM", MONO_SM, CLR_DIM),
        ]

    return data, session_map, project_window_map, snapshot


# ── Clickable Row View ────────────────────────────────────────────────────────

class FlippedView(NSView):
    """An NSView subclass with flipped coordinates (origin at top-left)."""
    def isFlipped(self):
        return True


class HoverButton(NSButton):
    """An NSButton that brightens on hover and shows a pointing hand cursor."""

    def initWithFrame_(self, frame):
        self = objc.super(HoverButton, self).initWithFrame_(frame)
        if self is None:
            return None
        tracking = NSTrackingArea.alloc().initWithRect_options_owner_userInfo_(
            NSZeroRect,
            0x01 | 0x80 | 0x200,  # mouseEnteredAndExited | activeAlways | inVisibleRect
            self, None,
        )
        self.addTrackingArea_(tracking)
        self._base_alpha = 1.0
        return self

    def mouseEntered_(self, event):
        # Brighten: ghost buttons go from 0.25 to 0.7, solid stay at 1.0
        self.setAlphaValue_(min(self._base_alpha + 0.45, 1.0))

    def mouseExited_(self, event):
        self.setAlphaValue_(self._base_alpha)


class ClickableRow(FlippedView):
    """A row view that highlights on hover and fires a callback on click."""

    def initWithFrame_tag_callback_delegate_(self, frame, tag, callback, delegate):
        self = objc.super(ClickableRow, self).initWithFrame_(frame)
        if self is None:
            return None
        self._tag = tag
        self._callback = callback
        self._delegate = delegate
        self._hovered = False
        tracking = NSTrackingArea.alloc().initWithRect_options_owner_userInfo_(
            NSZeroRect,
            0x01 | 0x80 | 0x200,  # mouseEnteredAndExited | activeAlways | inVisibleRect
            self, None,
        )
        self.addTrackingArea_(tracking)
        return self

    def mouseEntered_(self, event):
        self._hovered = True
        self.setNeedsDisplay_(True)

    def mouseExited_(self, event):
        self._hovered = False
        self.setNeedsDisplay_(True)

    def drawRect_(self, rect):
        if self._hovered:
            NSColor.controlAccentColor().colorWithAlphaComponent_(0.55).set()
            from AppKit import NSBezierPath
            NSBezierPath.fillRect_(self.bounds())

    def mouseDown_(self, event):
        if self._callback and self._delegate:
            getattr(self._delegate, self._callback)(self)

    def tag(self):
        return self._tag


