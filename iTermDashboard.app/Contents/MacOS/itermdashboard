def _build_role_summary(sess_list):
    """Build a compact role summary like '2 agent, 1 editor, 1 shell'."""
    from collections import Counter
    roles = Counter(s.role for s in sess_list)
    parts = []
    for role in ["agent", "editor", "build", "test", "server", "remote", "logs", "shell"]:
        count = roles.get(role, 0)
        if count > 0:
            parts.append(f"{count} {role}")
    return ", ".join(parts)


def _compute_snapshot(sessions, sorted_projects, git_statuses, total_claude, total_claude_mem):
    """Build a RefreshSnapshot from current data."""
    snap = RefreshSnapshot()
    snap.session_ids = {s.session_id for s in sessions}
    snap.project_paths = {path for path, _ in sorted_projects}
    snap.project_branches = {path: git_statuses[path].branch for path, _ in sorted_projects if path in git_statuses}
    snap.project_dirty = {path: git_statuses[path].dirty for path, _ in sorted_projects if path in git_statuses}
    snap.total_claude = total_claude
    snap.total_claude_mem_kb = total_claude_mem
    return snap


def _compute_deltas(prev, curr, sorted_projects, git_statuses):
    """Compute change descriptions between two snapshots."""
    if prev is None:
        return []

    deltas = []

    # New/closed sessions
    new_sids = curr.session_ids - prev.session_ids
    closed_sids = prev.session_ids - curr.session_ids
    if new_sids:
        deltas.append(f"[+] {len(new_sids)} new session{'s' if len(new_sids) > 1 else ''} opened")
    if closed_sids:
        deltas.append(f"[-] {len(closed_sids)} session{'s' if len(closed_sids) > 1 else ''} closed")

    # New/closed projects
    new_projs = curr.project_paths - prev.project_paths
    closed_projs = prev.project_paths - curr.project_paths
    for p in new_projs:
        deltas.append(f"[+] New project: {os.path.basename(p)}")
    for p in closed_projs:
        deltas.append(f"[-] Project closed: {os.path.basename(p)}")

    # Branch changes
    for path, _ in sorted_projects:
        pname = os.path.basename(path)
        old_branch = prev.project_branches.get(path)
        new_branch = curr.project_branches.get(path)
        if old_branch and new_branch and old_branch != new_branch:
            deltas.append(f"[~] {pname}: branch {old_branch} \u2192 {new_branch}")

        old_dirty = prev.project_dirty.get(path, 0)
        new_dirty = curr.project_dirty.get(path, 0)
        if old_dirty == 0 and new_dirty > 0:
            deltas.append(f"[~] {pname}: went dirty ({new_dirty} files)")
        elif old_dirty > 0 and new_dirty == 0:
            deltas.append(f"[~] {pname}: now clean")

    # Claude count changes
    claude_diff = curr.total_claude - prev.total_claude
    if claude_diff > 0:
        deltas.append(f"[+] {claude_diff} new Claude instance{'s' if claude_diff > 1 else ''}")
    elif claude_diff < 0:
        deltas.append(f"[-] {-claude_diff} Claude instance{'s' if -claude_diff > 1 else ''} closed")

    # Memory changes
    mem_diff_mb = (curr.total_claude_mem_kb - prev.total_claude_mem_kb) / 1024
    if abs(mem_diff_mb) >= 100:
        sign = "+" if mem_diff_mb > 0 else ""
        deltas.append(f"[~] Claude RAM {sign}{mem_diff_mb:.0f}M")

    return deltas


def collect_menu_data(prev_snapshot=None):
    """Collect all data. Returns (data, session_map, project_window_map, snapshot)."""
    sessions = get_iterm_sessions()
    # Also query Nexus if it's running (check first to avoid AppleScript relaunching it)
    try:
        running = subprocess.run(
            ["osascript", "-e", 'application "Nexus" is running'],
            capture_output=True, text=True, timeout=2,
        )
        if running.stdout.strip() == "true":
            nexus_sessions = get_nexus_sessions()
            sessions.extend(nexus_sessions)
    except Exception:
        pass
    if not sessions:
        return None, {}, {}, None

    enrich_sessions(sessions)

    home = os.path.expanduser("~")
    projects = defaultdict(list)  # keyed by git_root or cwd
    unassigned = []
    git_root_cache = {}  # cwd -> git_root or None

    for s in sessions:
        if not s.cwd or s.cwd == home:
            unassigned.append(s)
        else:
            cwd = s.cwd
            if cwd not in git_root_cache:
                git_root_cache[cwd] = find_git_root(cwd)
            root = git_root_cache[cwd] or cwd
            projects[root].append(s)

    def oldest_session_age(sess_list):
        max_age = 0
        for s in sess_list:
            if s.uptime:
                age = parse_etime(s.uptime)
                if age > max_age:
                    max_age = age
        return max_age

    sorted_projects = sorted(projects.items(), key=lambda x: -oldest_session_age(x[1]))

    git_statuses = {}
    for path, _ in sorted_projects:
        git_statuses[path] = get_git_status(path)

    total_claude = 0
    total_claude_mem = 0
    total_lsp = 0
    old_claude = []
    stale_sessions = []
    zombie_sessions = []
    remote_sessions = []
    prod_sessions = []

    for s in sessions:
        if s.is_claude:
            total_claude += 1
            total_claude_mem += s.mem_kb
            if s.uptime and parse_etime(s.uptime) > 5 * 86400:
                old_claude.append(s)
        if s.running_command == "sourcekit-lsp":
            total_lsp += 1
        if s.activity_state == "stale":
            stale_sessions.append(s)
        if s.activity_state == "zombie":
            zombie_sessions.append(s)
        if s.remote_type:
            remote_sessions.append(s)
        if s.is_production:
            prod_sessions.append(s)

    # Build snapshot and compute deltas
    snapshot = _compute_snapshot(sessions, sorted_projects, git_statuses, total_claude, total_claude_mem)
    deltas = _compute_deltas(prev_snapshot, snapshot, sorted_projects, git_statuses)

    data = {
        "projects": [],
        "unassigned": [],
        "insights": [],
        "deltas": deltas,
        "summary_segments": [],
    }

    session_map = {}
    project_window_map = {}
    tag_counter = 1000

    for proj_path, sess_list in sorted_projects:
        gs = git_statuses[proj_path]
        proj_name = os.path.basename(proj_path)
        warning = "\u26A0\uFE0F" if gs.dirty > 20 else ""
        if gs.conflicts:
            warning = "\u26A0\uFE0F CONFLICTS"

        role_summary = _build_role_summary(sess_list)

        proj_tag = tag_counter
        tag_counter += 1
        proj_app = sess_list[0].app_source if sess_list else "iTerm2"
        proj_window_ids = [s.window_id for s in sess_list]
        project_window_map[proj_tag] = (proj_window_ids, proj_app)

        # Group sessions by sub-project (relative path within the git root)
        subdir_groups = defaultdict(list)
        for s in sess_list:
            if s.cwd and s.cwd != proj_path:
                rel = os.path.relpath(s.cwd, proj_path)
                # Only use the first path component as the sub-project name
                subdir_name = rel.split(os.sep)[0]
            else:
                subdir_name = "."
            subdir_groups[subdir_name].append(s)

        has_subdirs = len(subdir_groups) > 1 or (len(subdir_groups) == 1 and "." not in subdir_groups)

        # Sort subdirs: "." first, then alphabetically
        sorted_subdirs = sorted(subdir_groups.keys(), key=lambda k: ("" if k == "." else k))

        def _sort_sessions(sess_group):
            claude_s = []
            named_s = []
            shell_s = []
            for s in sess_group:
                sname_lower = s.window_name.lower()
                if s.is_claude:
                    claude_s.append(s)
                elif re.match(r'^default\s*\(', sname_lower) or sname_lower.startswith("(-bash") or sname_lower.startswith("(-zsh"):
                    shell_s.append(s)
                else:
                    named_s.append(s)
            def session_age(s):
                return parse_etime(s.uptime) if s.uptime else 0
            claude_s.sort(key=session_age)
            named_s.sort(key=session_age)
            shell_s.sort(key=session_age)
            return claude_s + named_s + shell_s

        all_display = []
        subheader_positions = {}  # index -> subdir_name
        in_subgroup_indices = set()  # indices of sessions under a subheader

        for subdir_name in sorted_subdirs:
            group = subdir_groups[subdir_name]
            sorted_group = _sort_sessions(group)
            start_idx = len(all_display)
            if has_subdirs and subdir_name != ".":
                sub_tag = tag_counter
                tag_counter += 1
                sub_app = sorted_group[0].app_source if sorted_group else proj_app
                sub_window_ids = list(set(s.window_id for s in sorted_group))
                project_window_map[sub_tag] = (sub_window_ids, sub_app)
                subheader_positions[start_idx] = (subdir_name, sub_tag)
                for j in range(len(sorted_group)):
                    in_subgroup_indices.add(start_idx + j)
            elif has_subdirs and subdir_name == ".":
                sub_tag = tag_counter
                tag_counter += 1
                sub_app = sorted_group[0].app_source if sorted_group else proj_app
                sub_window_ids = list(set(s.window_id for s in sorted_group))
                project_window_map[sub_tag] = (sub_window_ids, sub_app)
                subheader_positions[start_idx] = (proj_name + "/", sub_tag)
                for j in range(len(sorted_group)):
                    in_subgroup_indices.add(start_idx + j)
            all_display.extend(sorted_group)

        claude_count = sum(1 for s in all_display if s.is_claude)

        session_entries = []
        for i, s in enumerate(all_display):
            # Insert sub-header if needed
            if i in subheader_positions:
                sh_name, sh_tag = subheader_positions[i]
                session_entries.append({
                    "type": "subheader",
                    "name": sh_name,
                    "tag": sh_tag,
                })

            is_last = (i == len(all_display) - 1)
            # Check if this is the last session in its subdir group
            next_is_subheader = (i + 1) in subheader_positions
            is_last_in_group = is_last or next_is_subheader
            segments = build_session_segments(s, is_last_in_group)
            s_tag = tag_counter
            tag_counter += 1
            session_map[s_tag] = (s.window_id, s.app_source)

            # Build rich tooltip
            proc_names = [p["cmd"].split()[0] for p in s.processes
                          if not any(skip in p["cmd"] for skip in ["login", "-bash", "-zsh"])]
            tooltip = f"Path: {s.cwd}\nProfile: {s.profile}\nSize: {s.columns}x{s.rows}"
            tooltip += f"\nRole: {s.role}"
            tooltip += f"\nState: {s.activity_state}"
            if s.fg_command:
                tooltip += f"\nForeground: {s.fg_command} {s.fg_args}"
            if s.remote_type:
                tooltip += f"\nRemote: {s.remote_type} {s.remote_target}"
            if s.idle_secs > 60:
                tooltip += f"\nIdle: {format_age(s.idle_secs)}"
            if proc_names:
                tooltip += f"\nProcesses: {', '.join(proc_names[:5])}"
            if s.is_claude:
                tooltip += f"\nMemory: {format_bytes(s.mem_kb)}  CPU: {s.cpu}%"

            # Choose icon based on role
            icon_name = ROLE_ICONS.get(s.role, "apple.terminal.fill")
            if s.is_claude:
                icon_color = CLR_PURPLE
            elif s.is_production:
                icon_color = CLR_RED
            elif s.remote_type:
                icon_color = CLR_CYAN
            elif s.activity_state in ("stale", "zombie"):
                icon_color = CLR_DIM
            else:
                icon_color = CLR_SECONDARY

            session_entries.append({
                "type": "session",
                "segments": segments,
                "tag": s_tag,
                "is_claude": s.is_claude,
                "tooltip": tooltip,
                "icon_name": icon_name,
                "icon_color": icon_color,
                "in_subgroup": i in in_subgroup_indices,
            })

        data["projects"].append({
            "header_segments": build_project_header_segments(proj_name, gs, warning, role_summary),
            "tag": proj_tag,
            "sessions": session_entries,
            "path": proj_path,
            "session_count": len(all_display),
            "claude_count": claude_count,
        })

    for i, s in enumerate(unassigned):
        is_last = (i == len(unassigned) - 1)
        segments = build_session_segments(s, is_last)
        s_tag = tag_counter
        tag_counter += 1
        session_map[s_tag] = (s.window_id, s.app_source)
        tooltip = f"Path: {s.cwd or '~'}\nProfile: {s.profile}\nSize: {s.columns}x{s.rows}"
        tooltip += f"\nRole: {s.role}\nState: {s.activity_state}"
        if s.fg_command:
            tooltip += f"\nForeground: {s.fg_command} {s.fg_args}"

        icon_name = ROLE_ICONS.get(s.role, "apple.terminal.fill")
        icon_color = CLR_PURPLE if s.is_claude else CLR_SECONDARY

        data["unassigned"].append({
            "segments": segments,
            "tag": s_tag,
            "is_claude": s.is_claude,
            "tooltip": tooltip,
            "icon_name": icon_name,
            "icon_color": icon_color,
        })

    # ── System Insights ──
    total_mem_str = format_bytes(total_claude_mem)
    data["insights"].append(f"[!] {total_claude} Claude instances (~{total_mem_str} RAM)")

    # Git-related insights
    for proj_path, sess_list in sorted_projects:
        gs = git_statuses[proj_path]
        proj_name = os.path.basename(proj_path)

        if gs.special_state:
            data["insights"].append(f"[!] {proj_name}: {gs.special_state} in progress")
        if gs.conflicts:
            data["insights"].append(f"[!] {proj_name}: {gs.conflicts} merge conflicts")
        if gs.detached:
            data["insights"].append(f"[!] {proj_name}: detached HEAD")

        for s in sess_list:
            if s.mem_kb > 500 * 1024:
                data["insights"].append(f"[!] {proj_name}: {format_bytes(s.mem_kb)} ({s.window_name})")
        if gs.dirty > 15:
            data["insights"].append(f"[!] {proj_name}: {gs.dirty} dirty files ({gs.untracked} untracked)")
        if gs.ahead > 3:
            data["insights"].append(f"[!] {proj_name}: {gs.ahead} unpushed commits")
        if gs.stashes:
            data["insights"].append(f"[i] {proj_name}: {gs.stashes} stash{'es' if gs.stashes > 1 else ''}")

    # Session health insights
    if prod_sessions:
        hosts = [s.remote_target or s.remote_type for s in prod_sessions]
        data["insights"].append(f"[!] {len(prod_sessions)} production session{'s' if len(prod_sessions) > 1 else ''}: {', '.join(hosts)}")
    if remote_sessions:
        data["insights"].append(f"[i] {len(remote_sessions)} remote session{'s' if len(remote_sessions) > 1 else ''} open")
    if stale_sessions:
        data["insights"].append(f"[i] {len(stale_sessions)} stale session{'s' if len(stale_sessions) > 1 else ''} (>30m idle)")
    if zombie_sessions:
        data["insights"].append(f"[!] {len(zombie_sessions)} zombie session{'s' if len(zombie_sessions) > 1 else ''}")
    if total_lsp:
        data["insights"].append(f"[i] {total_lsp} Swift LSP servers active")
    if old_claude:
        data["insights"].append(f"[i] {len(old_claude)} Claude instances >5d old")

    # Detect repos with multiple sub-project dirs open
    for proj_path, sess_list in sorted_projects:
        subdirs = set()
        for s in sess_list:
            if s.cwd and s.cwd != proj_path:
                rel = os.path.relpath(s.cwd, proj_path).split(os.sep)[0]
                subdirs.add(rel)
        if len(subdirs) > 1:
            data["insights"].append(f"[i] {os.path.basename(proj_path)}: {len(subdirs)} sub-projects active")

    shell_count = sum(1 for s in sessions if s.role == "shell")
    remote_count = len(remote_sessions)
    data["summary_segments"] = [
        (f"{len(sessions)}", BOLD_SM, CLR_ACCENT),
        (" win ", MONO_SM, CLR_DIM),
        ("\u2502", MONO_SM, CLR_DIM),
        (f" {total_claude}", BOLD_SM, CLR_PURPLE),
        (" agent ", MONO_SM, CLR_DIM),
        ("\u2502", MONO_SM, CLR_DIM),
        (f" {shell_count}", BOLD_SM, CLR_SECONDARY),
        (" shell ", MONO_SM, CLR_DIM),
    ]
    if remote_count:
        data["summary_segments"] += [
            ("\u2502", MONO_SM, CLR_DIM),
            (f" {remote_count}", BOLD_SM, CLR_CYAN),
            (" remote ", MONO_SM, CLR_DIM),
        ]
    if total_lsp:
        data["summary_segments"] += [
            ("\u2502", MONO_SM, CLR_DIM),
            (f" {total_lsp}", BOLD_SM, CLR_CYAN),
            (" LSP", MONO_SM, CLR_DIM),
        ]

    return data, session_map, project_window_map, snapshot


# ── Clickable Row View ────────────────────────────────────────────────────────

class FlippedView(NSView):
    """An NSView subclass with flipped coordinates (origin at top-left)."""
    def isFlipped(self):
        return True


class ClickableRow(FlippedView):
    """A row view that highlights on hover and fires a callback on click."""

    def initWithFrame_tag_callback_delegate_(self, frame, tag, callback, delegate):
        self = objc.super(ClickableRow, self).initWithFrame_(frame)
        if self is None:
            return None
        self._tag = tag
        self._callback = callback
        self._delegate = delegate
        self._hovered = False
        tracking = NSTrackingArea.alloc().initWithRect_options_owner_userInfo_(
            NSZeroRect,
            0x01 | 0x80 | 0x200,  # mouseEnteredAndExited | activeAlways | inVisibleRect
            self, None,
        )
        self.addTrackingArea_(tracking)
        return self

    def mouseEntered_(self, event):
        self._hovered = True
        self.setNeedsDisplay_(True)

    def mouseExited_(self, event):
        self._hovered = False
        self.setNeedsDisplay_(True)

    def drawRect_(self, rect):
        if self._hovered:
            NSColor.controlAccentColor().colorWithAlphaComponent_(0.15).set()
            from AppKit import NSBezierPath
            NSBezierPath.fillRect_(self.bounds())

    def mouseDown_(self, event):
        if self._callback and self._delegate:
            getattr(self._delegate, self._callback)(self)

    def tag(self):
        return self._tag


