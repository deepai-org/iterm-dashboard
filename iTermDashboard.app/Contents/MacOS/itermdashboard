def raise_app_window(window_id, app="iTerm2"):
    """Raise a specific app window without bringing other windows forward.

    Strategy:
    1. Use NSAppleScript (in-process, no subprocess) to set window index to 1
    2. Activate + AXRaise to bring just that window forward
    """
    from Foundation import NSAppleScript
    script = NSAppleScript.alloc().initWithSource_(
        f'tell application "{app}" to set index of window id {window_id} to 1')
    script.executeAndReturnError_(None)
    _ax_raise_and_activate(app)


def _get_ax_fns():
    """Load and cache HIServices accessibility functions."""
    if not hasattr(_get_ax_fns, '_fns'):
        _hi = objc.loadBundle('HIServices', {},
            '/System/Library/Frameworks/ApplicationServices.framework/Frameworks/HIServices.framework')
        fns = {}
        objc.loadBundleFunctions(_hi, fns, [
            ('AXUIElementCreateApplication', b'@i'),
            ('AXUIElementPerformAction', b'i@@'),
            ('AXUIElementCopyAttributeValue', b'i@@o^@'),
        ])
        _get_ax_fns._fns = fns
    return _get_ax_fns._fns


_running_app_cache = {}

def _find_running_app(app_name):
    """Find NSRunningApplication by localized name (cached)."""
    cached = _running_app_cache.get(app_name)
    if cached and not cached.isTerminated():
        return cached
    for a in NSWorkspace.sharedWorkspace().runningApplications():
        if a.localizedName() == app_name:
            _running_app_cache[app_name] = a
            return a
    return None


def _ax_raise_and_activate(app):
    """Activate app, then AXRaise only the frontmost window."""
    _ax_raise_n_and_activate(app, 1)


def _ax_raise_n_and_activate(app, count):
    """Activate app, then AXRaise only the top N windows.

    Activate first brings the app to foreground, then AXRaise repositions
    just the target windows to the top of the global z-order.
    Non-target windows fall back behind other apps.
    """
    running_app = _find_running_app(app) if isinstance(app, str) else app
    if not running_app:
        return
    try:
        fns = _get_ax_fns()
        running_app.activateWithOptions_(NSApplicationActivateIgnoringOtherApps)
        app_ref = fns['AXUIElementCreateApplication'](running_app.processIdentifier())
        err, ax_windows = fns['AXUIElementCopyAttributeValue'](app_ref, 'AXWindows', None)
        if err == 0 and ax_windows:
            n = min(count, len(ax_windows))
            for i in range(n - 1, -1, -1):
                fns['AXUIElementPerformAction'](ax_windows[i], 'AXRaise')
    except Exception:
        name = running_app.localizedName() if not isinstance(app, str) else app
        run_osascript(f'tell application "{name}" to activate')


def _ax_raise_matching_window(bundle_id, match_fn):
    """Find a window whose AX attributes satisfy match_fn, AXRaise it, activate the app.

    match_fn(ax_window, fns) -> bool is called for each window until one matches.
    Returns True if a window was raised, False otherwise.
    """
    running_app = _find_running_app_by_bundle(bundle_id)
    if not running_app:
        return False
    try:
        fns = _get_ax_fns()
        app_ref = fns['AXUIElementCreateApplication'](running_app.processIdentifier())
        err, ax_windows = fns['AXUIElementCopyAttributeValue'](app_ref, 'AXWindows', None)
        if err == 0 and ax_windows:
            for w in ax_windows:
                if match_fn(w, fns):
                    fns['AXUIElementPerformAction'](w, 'AXRaise')
                    running_app.activateWithOptions_(NSApplicationActivateIgnoringOtherApps)
                    return True
    except Exception:
        pass
    # Fallback: just activate
    running_app.activateWithOptions_(NSApplicationActivateIgnoringOtherApps)
    return False


def _find_running_app_by_bundle(bundle_id):
    """Find NSRunningApplication by bundle identifier (cached)."""
    cached = _running_app_cache.get(bundle_id)
    if cached and not cached.isTerminated():
        return cached
    for a in NSWorkspace.sharedWorkspace().runningApplications():
        if a.bundleIdentifier() == bundle_id:
            _running_app_cache[bundle_id] = a
            return a
    return None


def _get_screen_bounds():
    """Get usable screen area (excluding menu bar and dock) via NSScreen."""
    screen = NSScreen.mainScreen()
    if screen:
        vf = screen.visibleFrame()
        sf = screen.frame()
        # Convert from NSScreen coordinates (origin bottom-left) to screen coords (origin top-left)
        x1 = int(vf.origin.x)
        y1 = int(sf.size.height - vf.origin.y - vf.size.height)
        x2 = int(vf.origin.x + vf.size.width)
        y2 = int(sf.size.height - vf.origin.y)
        return (x1, y1, x2, y2)
    return (0, 25, 1920, 1080)


def _tile_if_overlapping_from_bounds(raw, window_ids, app="iTerm2"):
    """Tile windows if overlapping, using pre-read bounds string."""
    from Foundation import NSAppleScript
    orig_positions = {}
    sizes = {}
    for line in raw.strip().splitlines():
        parts = line.strip().split(",")
        if len(parts) == 5:
            try:
                wid = int(parts[0])
                x1, y1, x2, y2 = int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4])
                orig_positions[wid] = (x1, y1)
                sizes[wid] = (x2 - x1, y2 - y1)
            except ValueError:
                continue

    if len(orig_positions) < 2:
        return

    # Check if any pair actually overlaps before running solver
    wid_list = list(orig_positions.keys())
    has_overlap = False
    for i in range(len(wid_list)):
        for j in range(i + 1, len(wid_list)):
            w1, w2 = wid_list[i], wid_list[j]
            x1, y1 = orig_positions[w1]
            x2, y2 = orig_positions[w2]
            ww1, hh1 = sizes[w1]
            ww2, hh2 = sizes[w2]
            if not (x1 + ww1 <= x2 or x2 + ww2 <= x1 or y1 + hh1 <= y2 or y2 + hh2 <= y1):
                has_overlap = True
                break
        if has_overlap:
            break
    if not has_overlap:
        return

    screen = _get_screen_bounds()
    sx1, sy1, sx2, sy2 = screen
    # Allow windows to be placed up to MARGIN pixels outside screen to handle
    # off-by-one sizing issues (e.g. 865+864=1729 on 1728px screen)
    MARGIN = 4

    def rect_overlaps(r1, r2):
        return not (r1[0] + r1[2] <= r2[0] or r1[0] >= r2[0] + r2[2] or
                    r1[1] + r1[3] <= r2[1] or r1[1] >= r2[1] + r2[3])

    def total_overlap(positions):
        """Sum of overlap areas across all pairs."""
        ov = 0
        ws = list(positions.keys())
        for i in range(len(ws)):
            for j in range(i + 1, len(ws)):
                ax, ay = positions[ws[i]]
                aw, ah = sizes[ws[i]]
                bx, by = positions[ws[j]]
                bw, bh = sizes[ws[j]]
                ix = max(0, min(ax + aw, bx + bw) - max(ax, bx))
                iy = max(0, min(ay + ah, by + bh) - max(ay, by))
                ov += ix * iy
        return ov

    def solve_order(order):
        """Place windows sequentially in given order, return (positions, cost)."""
        placed = []  # list of [x, y, w, h]
        positions = {}

        for wid in order:
            ox, oy = orig_positions[wid]
            w, h = sizes[wid]

            # Generate candidate positions from geometric boundary grid
            candidates = set()
            candidates.add((ox, oy))
            candidates.add((sx1, oy))
            candidates.add((max(sx1, sx2 - w), oy))
            candidates.add((ox, sy1))
            candidates.add((ox, max(sy1, sy2 - h)))
            # Screen corners
            candidates.add((sx1, sy1))
            candidates.add((max(sx1, sx2 - w), sy1))
            candidates.add((sx1, max(sy1, sy2 - h)))
            candidates.add((max(sx1, sx2 - w), max(sy1, sy2 - h)))

            for px, py, pw, ph in placed:
                # Adjacent to each placed window
                candidates.add((px - w, oy))
                candidates.add((px + pw, oy))
                candidates.add((ox, py - h))
                candidates.add((ox, py + ph))
                # Corners of each placed window
                candidates.add((px - w, py - h))
                candidates.add((px + pw, py - h))
                candidates.add((px - w, py + ph))
                candidates.add((px + pw, py + ph))
                # Slide along edges
                candidates.add((px, oy))
                candidates.add((ox, py))
                candidates.add((px + pw - w, oy))
                candidates.add((ox, py + ph - h))

            best_pt = None
            best_dist = float('inf')

            for cx, cy in candidates:
                # Allow MARGIN overflow for off-by-one window sizes
                if cx < sx1 - MARGIN or cy < sy1 - MARGIN or cx + w > sx2 + MARGIN or cy + h > sy2 + MARGIN:
                    continue
                test = [cx, cy, w, h]
                if any(rect_overlaps(test, p) for p in placed):
                    continue
                dist = (cx - ox) ** 2 + (cy - oy) ** 2
                if dist < best_dist:
                    best_dist = dist
                    best_pt = (cx, cy)

            if best_pt is None:
                # No perfect placement — find position with least overlap
                best_ov = float('inf')
                for cx, cy in candidates:
                    if cx < sx1 - MARGIN or cy < sy1 - MARGIN or cx + w > sx2 + MARGIN or cy + h > sy2 + MARGIN:
                        continue
                    test = [cx, cy, w, h]
                    ov = sum(max(0, min(cx + w, p[0] + p[2]) - max(cx, p[0])) *
                            max(0, min(cy + h, p[1] + p[3]) - max(cy, p[1]))
                            for p in placed)
                    dist = (cx - ox) ** 2 + (cy - oy) ** 2
                    # Prioritize less overlap, then less distance
                    score = (ov, dist)
                    if score < (best_ov, best_dist):
                        best_ov = ov
                        best_dist = dist
                        best_pt = (cx, cy)

            if best_pt is None:
                # Absolute fallback
                best_pt = (max(sx1, min(ox, sx2 - w)), max(sy1, min(oy, sy2 - h)))

            positions[wid] = best_pt
            placed.append([best_pt[0], best_pt[1], w, h])

        ov = total_overlap(positions)
        disp = sum((positions[w][0] - orig_positions[w][0]) ** 2 +
                    (positions[w][1] - orig_positions[w][1]) ** 2
                    for w in order)
        return positions, ov, disp

    # 2. Try all permutations (N! — at most 720 for 6 windows)
    wids = list(orig_positions.keys())

    # For >6 windows, limit to a few heuristic orderings instead of full N!
    if len(wids) <= 6:
        orderings = list(permutations(wids))
    else:
        orderings = [wids, list(reversed(wids))]
        orderings.append(sorted(wids, key=lambda w: sizes[w][0] * sizes[w][1], reverse=True))
        orderings.append(sorted(wids, key=lambda w: orig_positions[w][0]))

    best_positions = None
    best_score = (float('inf'), float('inf'))  # (overlap, displacement)

    for order in orderings:
        positions, ov, disp = solve_order(order)
        score = (ov, disp)
        if score < best_score:
            best_score = score
            best_positions = positions

    if not best_positions:
        return

    # 3. Apply positions via AppleScript (only moved windows)
    set_parts = []
    for wid, (fx, fy) in best_positions.items():
        ox, oy = orig_positions[wid]
        w, h = sizes[wid]
        # Clamp to actual screen bounds for the final position
        fx = max(sx1, min(int(round(fx)), sx2 - w))
        fy = max(sy1, min(int(round(fy)), sy2 - h))
        if fx != ox or fy != oy:
            set_parts.append(f'''
                if id of w is {wid} then
                    set bounds of w to {{{fx}, {fy}, {fx + w}, {fy + h}}}
                end if''')

    if set_parts:
        set_script = f'''
        tell application "{app}"
            repeat with w in every window
                {"".join(set_parts)}
            end repeat
        end tell'''
        NSAppleScript.alloc().initWithSource_(set_script).executeAndReturnError_(None)


def raise_app_windows(window_ids, app="iTerm2"):
    """Raise specific windows by ID in a scriptable app.

    Same pattern as raise_app_window but for multiple windows:
    AppleScript reorders target windows, then AXRaise top N + activate.
    """
    from Foundation import NSAppleScript

    # Read bounds of target windows before raising (for overlap tiling)
    if len(window_ids) >= 2:
        bounds_checks = []
        for wid in window_ids:
            bounds_checks.append(
                f'try\nset b to bounds of window id {wid}\n'
                f'set output to output & "{wid}," & item 1 of b & "," & item 2 of b & "," & item 3 of b & "," & item 4 of b & linefeed\n'
                f'end try')
        bounds_script = NSAppleScript.alloc().initWithSource_(
            f'tell application "{app}"\nset output to ""\n' +
            "\n".join(bounds_checks) +
            '\nreturn output\nend tell')
        result, err = bounds_script.executeAndReturnError_(None)
        bounds_raw = result.stringValue() if result else ""
    else:
        bounds_raw = ""

    # AppleScript to reorder target windows to front within the app
    set_cmds = "\n".join(f'set index of window id {wid} to 1' for wid in window_ids)
    script = NSAppleScript.alloc().initWithSource_(
        f'tell application "{app}"\n{set_cmds}\nend tell')
    script.executeAndReturnError_(None)

    # AXRaise top N + activate (same pattern as single-window raise)
    _ax_raise_n_and_activate(app, len(window_ids))

    # Tile overlapping windows apart (only moves target windows)
    if bounds_raw:
        _tile_if_overlapping_from_bounds(bounds_raw, window_ids, app=app)


def _raise_companion_app(bundle_id, app_name, proj_path):
    """Raise only the matching companion app window without bringing all windows forward.

    For scriptable apps (BBEdit, Finder): AppleScript selects/reorders the target window
    within the app, then _ax_raise_and_activate brings just that window forward.
    For non-scriptable apps (PyCharm): _ax_raise_matching_window finds and raises
    the window by AX title attribute.

    If no matching window is found (stale data), falls back to opening a new one.
    """
    from Foundation import NSAppleScript

    if app_name == "BBEdit":
        hfs_suffix = ":" + proj_path.lstrip("/").replace("/", ":") + ":"
        # Return "found" or "" to detect if a matching doc exists
        script = NSAppleScript.alloc().initWithSource_(f'''tell application "BBEdit"
set dl to every text document
repeat with i from 1 to count of dl
try
set f to file of (item i of dl)
if (f as text) contains "{hfs_suffix}" then
tell (item i of dl) to select
return "found"
end if
end try
end repeat
return ""
end tell''')
        result, err = script.executeAndReturnError_(None)
        found = result and result.stringValue() == "found"
        if found:
            _ax_raise_and_activate("BBEdit")
        else:
            _open_companion_app(bundle_id, app_name, proj_path)

    elif app_name == "Finder":
        script = NSAppleScript.alloc().initWithSource_(f'''tell application "Finder"
set n to count of Finder windows
repeat with i from 1 to n
try
set p to POSIX path of (target of Finder window i as alias)
if p starts with "{proj_path}" then
set index of Finder window i to 1
return "found"
end if
end try
end repeat
return ""
end tell''')
        result, err = script.executeAndReturnError_(None)
        found = result and result.stringValue() == "found"
        if found:
            _ax_raise_and_activate("Finder")
        else:
            _open_companion_app(bundle_id, app_name, proj_path)

    elif app_name == "PyCharm":
        proj_basename = os.path.basename(proj_path)
        def _match_pycharm(w, fns):
            err, title = fns['AXUIElementCopyAttributeValue'](w, 'AXTitle', None)
            return err == 0 and title and str(title).startswith(proj_basename)
        if not _ax_raise_matching_window(bundle_id, _match_pycharm):
            _open_companion_app(bundle_id, app_name, proj_path)

    else:
        subprocess.run(["open", "-b", bundle_id], capture_output=True, timeout=5)


def _open_new_terminal(cwd, app="iTerm2"):
    """Open a new terminal window in the given directory."""
    from Foundation import NSAppleScript
    escaped = cwd.replace('"', '\\"')
    if app in ("iTerm2", "Nexus"):
        script = NSAppleScript.alloc().initWithSource_(f'''
tell application "{app}"
    activate
    set newWindow to (create window with default profile)
    tell current session of newWindow
        write text "cd \\"{escaped}\\""
    end tell
end tell''')
        script.executeAndReturnError_(None)
    elif app == "Terminal":
        script = NSAppleScript.alloc().initWithSource_(f'''
tell application "Terminal"
    activate
    do script "cd \\"{escaped}\\""
end tell''')
        script.executeAndReturnError_(None)


def _open_companion_app(bundle_id, app_name, folder_path):
    """Open a folder in a companion app (Finder/BBEdit/PyCharm)."""
    from Foundation import NSAppleScript
    if app_name == "Finder":
        script = NSAppleScript.alloc().initWithSource_(
            f'tell application "Finder" to open POSIX file "{folder_path}"')
        script.executeAndReturnError_(None)
        _ax_raise_and_activate("Finder")
    elif app_name == "BBEdit":
        script = NSAppleScript.alloc().initWithSource_(
            f'tell application "BBEdit" to open POSIX file "{folder_path}"')
        script.executeAndReturnError_(None)
        _ax_raise_and_activate("BBEdit")
    elif app_name == "PyCharm":
        subprocess.Popen(["open", "-b", bundle_id, folder_path],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.Popen(["open", "-b", bundle_id, folder_path],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ── Formatting ────────────────────────────────────────────────────────────────

NAME_WIDTH = 24


def format_bytes(kb):
    if kb == 0:
        return ""
    mb = kb / 1024
    if mb >= 1024:
        return f"{mb/1024:.1f}G"
    return f"{mb:.0f}M"


def parse_etime(etime):
    days = 0
    if "-" in etime:
        d, rest = etime.split("-", 1)
        days = int(d)
        etime = rest
    parts = [int(p) for p in etime.split(":")]
    if len(parts) == 3:
        return days * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]
    elif len(parts) == 2:
        return days * 86400 + parts[0] * 60 + parts[1]
    return days * 86400


def format_uptime(etime):
    secs = parse_etime(etime)
    days = secs // 86400
    hours = (secs % 86400) // 3600
    mins = (secs % 3600) // 60
    if days > 0:
        return f"{days}d{hours}h"
    if hours > 0:
        return f"{hours}h{mins}m"
    return f"{mins}m"


def format_age(secs):
    """Format seconds into a short age string like '2h' or '3d'."""
    if secs <= 0:
        return ""
    days = secs // 86400
    hours = (secs % 86400) // 3600
    mins = (secs % 3600) // 60
    if days > 0:
        return f"{days}d"
    if hours > 0:
        return f"{hours}h"
    return f"{mins}m"


def git_badge(gs):
    if not gs.is_git:
        return "[no git]"

    parts = []

    # Special state prefix
    if gs.special_state:
        parts.append(gs.special_state + " |")

    # Branch (with detached/worktree indicator)
    branch = f"@{gs.branch}" if gs.detached else gs.branch
    if gs.worktree:
        branch += " (wt)"
    parts.append(branch)

    # File status — human-readable
    if gs.dirty:
        status_parts = []
        if gs.staged:
            status_parts.append(f"{gs.staged} staged")
        if gs.modified:
            status_parts.append(f"{gs.modified} mod")
        if gs.untracked:
            status_parts.append(f"{gs.untracked} new")
        if gs.conflicts:
            status_parts.append(f"{gs.conflicts} conflict")
        parts.append(", ".join(status_parts) if status_parts else f"{gs.dirty} dirty")
    else:
        parts.append("\u2713 clean")

    # Remote tracking
    if gs.has_remote:
        if gs.ahead and gs.behind:
            parts.append(f"\u2191{gs.ahead} \u2193{gs.behind}")
        elif gs.ahead:
            parts.append(f"\u2191{gs.ahead} unpushed")
        elif gs.behind:
            parts.append(f"\u2193{gs.behind} behind")
    else:
        parts.append("no remote")

    # Stashes
    if gs.stashes:
        parts.append(f"{gs.stashes} stash")

    # Last commit age (only if > 1 day)
    if gs.last_commit_age_secs > 86400:
        parts.append(f"{format_age(gs.last_commit_age_secs)} ago")

    return parts[0] + "  " + " \u00B7 ".join(parts[1:])


