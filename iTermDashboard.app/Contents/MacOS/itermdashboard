def raise_app_window(window_id, app="iTerm2"):
    script = f'''
    tell application "{app}"
        activate
        repeat with w in every window
            if id of w is {window_id} then
                set index of w to 1
            end if
        end repeat
    end tell'''
    run_osascript(script)


def _get_screen_bounds():
    """Get usable screen area (excluding menu bar) via AppleScript."""
    raw = run_osascript('''
        tell application "Finder"
            set db to bounds of window of desktop
            return (item 1 of db as text) & "," & (item 2 of db as text) & "," & (item 3 of db as text) & "," & (item 4 of db as text)
        end tell
    ''')
    if raw:
        try:
            parts = [int(x.strip()) for x in raw.split(",")]
            if len(parts) == 4:
                # Adjust top for menu bar (~25px)
                return (parts[0], max(parts[1], 25), parts[2], parts[3])
        except ValueError:
            pass
    return (0, 25, 1920, 1080)


def _tile_windows_if_overlapping(window_ids, app="iTerm2"):
    """
    Minimum-displacement window tiling via deterministic sequential placement.
    Tries all permutations (N! — fine for ≤6 windows) to avoid the anchor problem.
    Accepts the best solution even if minor overlap remains (e.g. 1px off-by-one).
    """
    if len(window_ids) <= 1:
        return

    # 1. Read current bounds for each window
    read_parts = []
    for wid in window_ids:
        read_parts.append(f'''
            if id of w is {wid} then
                set b to bounds of w
                set output to output & "{wid}," & item 1 of b & "," & item 2 of b & "," & item 3 of b & "," & item 4 of b & linefeed
            end if''')

    read_script = f'''
    tell application "{app}"
        set output to ""
        repeat with w in every window
            {"".join(read_parts)}
        end repeat
        return output
    end tell'''

    raw = run_osascript(read_script)
    if not raw:
        return

    orig_positions = {}
    sizes = {}
    for line in raw.strip().splitlines():
        parts = line.strip().split(",")
        if len(parts) == 5:
            try:
                wid = int(parts[0])
                x1, y1, x2, y2 = int(parts[1]), int(parts[2]), int(parts[3]), int(parts[4])
                orig_positions[wid] = (x1, y1)
                sizes[wid] = (x2 - x1, y2 - y1)
            except ValueError:
                continue

    if len(orig_positions) < 2:
        return

    # Check if any pair actually overlaps before running solver
    wid_list = list(orig_positions.keys())
    has_overlap = False
    for i in range(len(wid_list)):
        for j in range(i + 1, len(wid_list)):
            w1, w2 = wid_list[i], wid_list[j]
            x1, y1 = orig_positions[w1]
            x2, y2 = orig_positions[w2]
            ww1, hh1 = sizes[w1]
            ww2, hh2 = sizes[w2]
            if not (x1 + ww1 <= x2 or x2 + ww2 <= x1 or y1 + hh1 <= y2 or y2 + hh2 <= y1):
                has_overlap = True
                break
        if has_overlap:
            break
    if not has_overlap:
        return

    screen = _get_screen_bounds()
    sx1, sy1, sx2, sy2 = screen
    # Allow windows to be placed up to MARGIN pixels outside screen to handle
    # off-by-one sizing issues (e.g. 865+864=1729 on 1728px screen)
    MARGIN = 4

    def rect_overlaps(r1, r2):
        return not (r1[0] + r1[2] <= r2[0] or r1[0] >= r2[0] + r2[2] or
                    r1[1] + r1[3] <= r2[1] or r1[1] >= r2[1] + r2[3])

    def total_overlap(positions):
        """Sum of overlap areas across all pairs."""
        ov = 0
        ws = list(positions.keys())
        for i in range(len(ws)):
            for j in range(i + 1, len(ws)):
                ax, ay = positions[ws[i]]
                aw, ah = sizes[ws[i]]
                bx, by = positions[ws[j]]
                bw, bh = sizes[ws[j]]
                ix = max(0, min(ax + aw, bx + bw) - max(ax, bx))
                iy = max(0, min(ay + ah, by + bh) - max(ay, by))
                ov += ix * iy
        return ov

    def solve_order(order):
        """Place windows sequentially in given order, return (positions, cost)."""
        placed = []  # list of [x, y, w, h]
        positions = {}

        for wid in order:
            ox, oy = orig_positions[wid]
            w, h = sizes[wid]

            # Generate candidate positions from geometric boundary grid
            candidates = set()
            candidates.add((ox, oy))
            candidates.add((sx1, oy))
            candidates.add((max(sx1, sx2 - w), oy))
            candidates.add((ox, sy1))
            candidates.add((ox, max(sy1, sy2 - h)))
            # Screen corners
            candidates.add((sx1, sy1))
            candidates.add((max(sx1, sx2 - w), sy1))
            candidates.add((sx1, max(sy1, sy2 - h)))
            candidates.add((max(sx1, sx2 - w), max(sy1, sy2 - h)))

            for px, py, pw, ph in placed:
                # Adjacent to each placed window
                candidates.add((px - w, oy))
                candidates.add((px + pw, oy))
                candidates.add((ox, py - h))
                candidates.add((ox, py + ph))
                # Corners of each placed window
                candidates.add((px - w, py - h))
                candidates.add((px + pw, py - h))
                candidates.add((px - w, py + ph))
                candidates.add((px + pw, py + ph))
                # Slide along edges
                candidates.add((px, oy))
                candidates.add((ox, py))
                candidates.add((px + pw - w, oy))
                candidates.add((ox, py + ph - h))

            best_pt = None
            best_dist = float('inf')

            for cx, cy in candidates:
                # Allow MARGIN overflow for off-by-one window sizes
                if cx < sx1 - MARGIN or cy < sy1 - MARGIN or cx + w > sx2 + MARGIN or cy + h > sy2 + MARGIN:
                    continue
                test = [cx, cy, w, h]
                if any(rect_overlaps(test, p) for p in placed):
                    continue
                dist = (cx - ox) ** 2 + (cy - oy) ** 2
                if dist < best_dist:
                    best_dist = dist
                    best_pt = (cx, cy)

            if best_pt is None:
                # No perfect placement — find position with least overlap
                best_ov = float('inf')
                for cx, cy in candidates:
                    if cx < sx1 - MARGIN or cy < sy1 - MARGIN or cx + w > sx2 + MARGIN or cy + h > sy2 + MARGIN:
                        continue
                    test = [cx, cy, w, h]
                    ov = sum(max(0, min(cx + w, p[0] + p[2]) - max(cx, p[0])) *
                            max(0, min(cy + h, p[1] + p[3]) - max(cy, p[1]))
                            for p in placed)
                    dist = (cx - ox) ** 2 + (cy - oy) ** 2
                    # Prioritize less overlap, then less distance
                    score = (ov, dist)
                    if score < (best_ov, best_dist):
                        best_ov = ov
                        best_dist = dist
                        best_pt = (cx, cy)

            if best_pt is None:
                # Absolute fallback
                best_pt = (max(sx1, min(ox, sx2 - w)), max(sy1, min(oy, sy2 - h)))

            positions[wid] = best_pt
            placed.append([best_pt[0], best_pt[1], w, h])

        ov = total_overlap(positions)
        disp = sum((positions[w][0] - orig_positions[w][0]) ** 2 +
                    (positions[w][1] - orig_positions[w][1]) ** 2
                    for w in order)
        return positions, ov, disp

    # 2. Try all permutations (N! — at most 720 for 6 windows)
    wids = list(orig_positions.keys())

    # For >6 windows, limit to a few heuristic orderings instead of full N!
    if len(wids) <= 6:
        orderings = list(permutations(wids))
    else:
        orderings = [wids, list(reversed(wids))]
        orderings.append(sorted(wids, key=lambda w: sizes[w][0] * sizes[w][1], reverse=True))
        orderings.append(sorted(wids, key=lambda w: orig_positions[w][0]))

    best_positions = None
    best_score = (float('inf'), float('inf'))  # (overlap, displacement)

    for order in orderings:
        positions, ov, disp = solve_order(order)
        score = (ov, disp)
        if score < best_score:
            best_score = score
            best_positions = positions

    if not best_positions:
        return

    # 3. Apply positions via AppleScript (only moved windows)
    set_parts = []
    for wid, (fx, fy) in best_positions.items():
        ox, oy = orig_positions[wid]
        w, h = sizes[wid]
        # Clamp to actual screen bounds for the final position
        fx = max(sx1, min(int(round(fx)), sx2 - w))
        fy = max(sy1, min(int(round(fy)), sy2 - h))
        if fx != ox or fy != oy:
            set_parts.append(f'''
                if id of w is {wid} then
                    set bounds of w to {{{fx}, {fy}, {fx + w}, {fy + h}}}
                end if''')

    if set_parts:
        set_script = f'''
        tell application "{app}"
            repeat with w in every window
                {"".join(set_parts)}
            end repeat
        end tell'''
        run_osascript(set_script)


def raise_app_windows(window_ids, app="iTerm2"):
    # First tile if overlapping, then raise
    _tile_windows_if_overlapping(window_ids, app)

    conditions = " or ".join(f"id of w is {wid}" for wid in window_ids)
    script = f'''
    tell application "{app}"
        activate
        repeat with w in every window
            if {conditions} then
                set index of w to 1
            end if
        end repeat
    end tell'''
    run_osascript(script)


# ── Formatting ────────────────────────────────────────────────────────────────

NAME_WIDTH = 24


def format_bytes(kb):
    if kb == 0:
        return ""
    mb = kb / 1024
    if mb >= 1024:
        return f"{mb/1024:.1f}G"
    return f"{mb:.0f}M"


def parse_etime(etime):
    days = 0
    if "-" in etime:
        d, rest = etime.split("-", 1)
        days = int(d)
        etime = rest
    parts = [int(p) for p in etime.split(":")]
    if len(parts) == 3:
        return days * 86400 + parts[0] * 3600 + parts[1] * 60 + parts[2]
    elif len(parts) == 2:
        return days * 86400 + parts[0] * 60 + parts[1]
    return days * 86400


def format_uptime(etime):
    secs = parse_etime(etime)
    days = secs // 86400
    hours = (secs % 86400) // 3600
    mins = (secs % 3600) // 60
    if days > 0:
        return f"{days}d{hours}h"
    if hours > 0:
        return f"{hours}h{mins}m"
    return f"{mins}m"


def format_age(secs):
    """Format seconds into a short age string like '2h' or '3d'."""
    if secs <= 0:
        return ""
    days = secs // 86400
    hours = (secs % 86400) // 3600
    mins = (secs % 3600) // 60
    if days > 0:
        return f"{days}d"
    if hours > 0:
        return f"{hours}h"
    return f"{mins}m"


def git_badge(gs):
    if not gs.is_git:
        return "[no git]"

    parts = []

    # Special state prefix
    if gs.special_state:
        parts.append(gs.special_state)
        parts.append("|")

    # Branch (with detached indicator)
    if gs.detached:
        parts.append(f"@{gs.branch}")
    else:
        parts.append(gs.branch)

    # Worktree indicator
    if gs.worktree:
        parts.append("(wt)")

    # File status breakdown
    if gs.dirty:
        status_parts = []
        if gs.staged:
            status_parts.append(f"S{gs.staged}")
        if gs.modified:
            status_parts.append(f"M{gs.modified}")
        if gs.untracked:
            status_parts.append(f"?{gs.untracked}")
        if gs.conflicts:
            status_parts.append(f"!{gs.conflicts}")
        parts.append(" ".join(status_parts) if status_parts else f"*{gs.dirty}")
    else:
        parts.append("\u2713")

    # Remote tracking
    if gs.has_remote:
        if gs.ahead:
            parts.append(f"\u2191{gs.ahead}")
        if gs.behind:
            parts.append(f"\u2193{gs.behind}")
        if not gs.ahead and not gs.behind:
            parts.append("=")
    else:
        parts.append("\u2298")

    # Last commit age (only if > 1 day)
    if gs.last_commit_age_secs > 86400:
        parts.append(f"({format_age(gs.last_commit_age_secs)} ago)")

    return "[" + " ".join(parts) + "]"


