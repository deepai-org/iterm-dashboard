SIDEBAR_WIDTH = 280
SIDEBAR_COLLAPSED_WIDTH = 8   # invisible hit zone width
SIDEBAR_STRIP_WIDTH = 2       # visible accent strip
SIDEBAR_HOVER_DELAY = 0.1     # seconds before expand
SIDEBAR_EXIT_DELAY = 0.3      # seconds before collapse
SIDEBAR_ANIM_DURATION = 0.15  # slide animation duration

TERMINAL_BUNDLE_IDS = {
    "com.googlecode.iterm2",
    "com.nexus.terminal",
}



def _build_sidebar_row(segments, indent=0, icon=None, tag=0, callback=None,
                       delegate=None, tooltip=None, is_header=False, right_margin=4,
                       tree_lines=None):
    """Build a single row view with icon + attributed text.

    tree_lines: list of (level, kind) where level is indent depth (1-based) and kind is:
        "mid"  = ├─  branch with continuation (vertical full height + horizontal)
        "last" = └─  last branch (vertical top half + horizontal)
        "cont" = │   vertical continuation only (no horizontal branch)
    """
    row_height = 22 if not is_header else 26
    left_pad = 8 + indent * 14

    if callback and delegate:
        row = ClickableRow.alloc().initWithFrame_tag_callback_delegate_(
            NSMakeRect(0, 0, SIDEBAR_WIDTH, row_height), tag, callback, delegate
        )
    else:
        row = FlippedView.alloc().initWithFrame_(NSMakeRect(0, 0, SIDEBAR_WIDTH, row_height))

    x = left_pad

    # Draw tree connector lines at each level
    if tree_lines:
        line_clr = CLR_SECONDARY.CGColor()
        mid_y = round(row_height / 2.0)
        for level, kind in tree_lines:
            tree_x = 8 + level * 14 - 7  # x position for this indent level's vertical line

            if kind in ("mid", "last"):
                # Horizontal branch from vertical line to icon
                h_line = NSView.alloc().initWithFrame_(NSMakeRect(tree_x, mid_y, 7, 1))
                h_line.setWantsLayer_(True)
                h_line.layer().setBackgroundColor_(line_clr)
                row.addSubview_(h_line)

            if kind == "mid":
                v_line = NSView.alloc().initWithFrame_(NSMakeRect(tree_x, 0, 1, row_height))
                v_line.setWantsLayer_(True)
                v_line.layer().setBackgroundColor_(line_clr)
                row.addSubview_(v_line)
            elif kind == "last":
                v_line = NSView.alloc().initWithFrame_(NSMakeRect(tree_x, 0, 1, mid_y))
                v_line.setWantsLayer_(True)
                v_line.layer().setBackgroundColor_(line_clr)
                row.addSubview_(v_line)
            elif kind == "cont":
                v_line = NSView.alloc().initWithFrame_(NSMakeRect(tree_x, 0, 1, row_height))
                v_line.setWantsLayer_(True)
                v_line.layer().setBackgroundColor_(line_clr)
                row.addSubview_(v_line)

    icon_x = x
    if icon:
        x += 18

    # Create label first so we can measure its natural height
    label = NSTextField.alloc().initWithFrame_(NSMakeRect(x, 0, SIDEBAR_WIDTH - x - right_margin, row_height))
    label.setBezeled_(False)
    label.setDrawsBackground_(False)
    label.setEditable_(False)
    label.setSelectable_(False)
    # Strip tree connector chars from segments for sidebar display
    clean_segs = []
    for text, font, color in segments:
        cleaned = text.lstrip(" \u251C\u2514\u2500\u2502")
        if cleaned:
            clean_segs.append((cleaned, font, color))
    label.setAttributedStringValue_(rich_text(clean_segs if clean_segs else segments))
    label.sizeToFit()
    # Center the label vertically in the row
    label_h = label.frame().size.height
    label_y = round((row_height - label_h) / 2.0)
    label.setFrame_(NSMakeRect(x, label_y, SIDEBAR_WIDTH - x - right_margin, label_h))
    if tooltip:
        label.setToolTip_(tooltip)
    row.addSubview_(label)

    if icon:
        icon_size = 14
        # Align icon center with label center
        label_center = label_y + label_h / 2.0
        icon_y = round(label_center - icon_size / 2.0)
        iv = NSImageView.alloc().initWithFrame_(NSMakeRect(icon_x, icon_y, icon_size, icon_size))
        iv.setImage_(icon)
        row.addSubview_(iv)

    return row


def _build_separator():
    """Build a thin separator line."""
    sep = NSView.alloc().initWithFrame_(NSMakeRect(0, 0, SIDEBAR_WIDTH, 8))
    line = NSView.alloc().initWithFrame_(NSMakeRect(12, 3, SIDEBAR_WIDTH - 24, 1))
    line.setWantsLayer_(True)
    line.layer().setBackgroundColor_(NSColor.separatorColor().CGColor())
    sep.addSubview_(line)
    return sep


def build_sidebar_content(data, delegate):
    """Build an array of row views from the dashboard data."""
    rows = []

    delegate._companion_map = {}
    delegate._open_companion_map = {}
    delegate._resume_map = {}
    delegate._devvm_connect_map = {}
    delegate._devvm_cleanup_map = {}
    delegate._next_companion_tag = 10000
    _resume_tag_counter = 20000

    def _add_app_badges(row, folder_path, existing_apps):
        """Add companion app badges to a row: solid for present apps, ghost for missing."""
        badge_size = 18
        badge_pad = 3
        all_apps = ["Finder", "BBEdit", "PyCharm"]
        badge_x = SIDEBAR_WIDTH - 6
        row_h = row.frame().size.height
        badge_y = round((row_h - badge_size) / 2.0)
        for app_name in reversed(all_apps):
            info = COMPANION_APPS.get(app_name, {})
            app_path = NSWorkspace.sharedWorkspace().absolutePathForAppBundleWithIdentifier_(info["bundle"])
            app_icon = NSWorkspace.sharedWorkspace().iconForFile_(app_path) if app_path else None
            if not app_icon:
                continue
            badge_x -= badge_size + badge_pad
            app_icon = app_icon.copy()
            app_icon.setSize_((badge_size, badge_size))
            is_present = app_name in existing_apps
            btn = HoverButton.alloc().initWithFrame_(NSMakeRect(badge_x, badge_y, badge_size, badge_size))
            btn.setImage_(app_icon)
            btn.setBordered_(False)
            btn.setTarget_(delegate)
            c_tag = delegate._next_companion_tag
            delegate._next_companion_tag += 1
            btn.setTag_(c_tag)
            if is_present:
                btn.setToolTip_(app_name)
                btn.setAction_(objc.selector(delegate.companionClicked_, signature=b'v@:@'))
                delegate._companion_map[c_tag] = (info["bundle"], app_name, folder_path)
                btn._base_alpha = 1.0
            else:
                btn._base_alpha = 0.25
                btn.setAlphaValue_(0.25)
                btn.setToolTip_(f"Open in {app_name}")
                btn.setAction_(objc.selector(delegate.openCompanionClicked_, signature=b'v@:@'))
                delegate._open_companion_map[c_tag] = (info["bundle"], app_name, folder_path)
            row.addSubview_(btn)

    if data is None:
        rows.append(_build_sidebar_row([("Loading...", MONO_SM, CLR_DIM)]))
        return rows

    # ── Workspaces header ──
    rows.append(_build_sidebar_row(
        [("WORKSPACES", BOLD, CLR_LABEL), (f"  ({len(data['projects'])})", MONO_SM, CLR_DIM)],
        icon=sf_symbol("square.grid.2x2.fill", color=CLR_ACCENT, size=11.0),
        is_header=True,
    ))
    rows.append(_build_separator())

    # Pre-resolve app icon paths once (avoid repeated lookups per row)
    _app_badge_size = 18
    _app_badge_margin = 8 + 3 * (_app_badge_size + 3)  # space for 3 badges

    for proj in data["projects"]:
        companion_apps = proj.get("companion_apps", [])

        row = _build_sidebar_row(
            proj["header_segments"],
            icon=sf_symbol("folder.fill", color=CLR_ACCENT, size=11.0),
            tag=proj["tag"], callback="projectClicked_", delegate=delegate,
            tooltip=f"{proj['path']}\n{proj['session_count']} sessions, {proj['claude_count']} Claude",
            is_header=True,
            right_margin=_app_badge_margin,
        )
        _add_app_badges(row, proj["path"], companion_apps)
        rows.append(row)

        # Git status on its own row
        git_segs = proj.get("git_segments")
        if git_segs:
            has_children = bool(proj["sessions"]) or bool(proj.get("resumable"))
            git_row = _build_sidebar_row(
                git_segs,
                indent=1,
                icon=sf_symbol("arrow.triangle.branch", color=CLR_DIM, size=9.0),
                tree_lines=[(1, "mid" if has_children else "last")],
            )
            rows.append(git_row)

        sessions = proj["sessions"]
        resumable = proj.get("resumable", [])

        def _has_more_toplevel(after_idx):
            """Check if there are more top-level items after after_idx."""
            for j in range(after_idx, len(sessions)):
                s = sessions[j]
                if not s.get("in_subgroup"):
                    return True
            # Resumable sessions also count as more items
            return bool(resumable)

        for si, sess in enumerate(sessions):
            if sess.get("type") == "subheader":
                more_top = _has_more_toplevel(si + 1)
                # Find end of this subgroup to check if more top-level after it
                end = si + 1
                while end < len(sessions) and sessions[end].get("in_subgroup"):
                    end += 1
                more_after_group = _has_more_toplevel(end)
                kind = "mid" if more_after_group else "last"
                sub_row = _build_sidebar_row(
                    [(sess["name"] + "/", BOLD_SM, CLR_ACCENT)],
                    indent=1,
                    icon=sf_symbol("folder", color=CLR_DIM, size=10.0),
                    tag=sess["tag"], callback="projectClicked_", delegate=delegate,
                    tree_lines=[(1, kind)],
                    right_margin=_app_badge_margin,
                )
                sub_path = sess.get("path", proj["path"])
                _add_app_badges(sub_row, sub_path, companion_apps)
                rows.append(sub_row)
                continue

            if sess.get("in_subgroup"):
                # Is this the last in its subgroup?
                is_last_sub = (si == len(sessions) - 1) or \
                    not sessions[si + 1].get("in_subgroup") or \
                    sessions[si + 1].get("type") == "subheader"
                # Does the parent (level 1) continue after this subgroup?
                end = si + 1
                while end < len(sessions) and sessions[end].get("in_subgroup"):
                    end += 1
                parent_continues = _has_more_toplevel(end)
                lines = []
                # Level 1: continuation if more top-level siblings after this subgroup
                if parent_continues:
                    lines.append((1, "cont"))
                # Level 2: branch for this child
                lines.append((2, "last" if is_last_sub else "mid"))
                indent = 2
            else:
                # Top-level session
                more = _has_more_toplevel(si + 1)
                lines = [(1, "mid" if more else "last")]
                indent = 1

            rows.append(_build_sidebar_row(
                sess["segments"],
                indent=indent,
                icon=sf_symbol(
                    sess.get("icon_name", "apple.terminal.fill"),
                    color=sess.get("icon_color", CLR_SECONDARY),
                    size=10.0,
                ),
                tag=sess["tag"], callback="sessionClicked_", delegate=delegate,
                tooltip=sess.get("tooltip"),
                tree_lines=lines,
            ))

        # ── Resumable Claude sessions ──
        if resumable:
            for ri, cs in enumerate(resumable):
                age_secs = time.time() - cs.timestamp
                age_str = format_age(int(age_secs))
                summary = cs.summary
                # Truncate summary to fit
                max_summary = 40
                if len(summary) > max_summary:
                    summary = summary[:max_summary - 1] + "\u2026"
                is_last = (ri == len(resumable) - 1)
                segments = [
                    ("\u25B7 ", MONO_SM, CLR_DIM),
                    (summary + "  ", MONO_SM, CLR_SECONDARY),
                    (age_str, MONO_SM, CLR_DIM),
                ]
                r_tag = _resume_tag_counter
                _resume_tag_counter += 1
                delegate._resume_map[r_tag] = (cs.session_id, cs.project_path)
                tree_kind = "last" if is_last else "mid"
                rows.append(_build_sidebar_row(
                    segments,
                    indent=1,
                    icon=sf_symbol("arrow.counterclockwise", color=CLR_DIM, size=9.0),
                    tag=r_tag, callback="resumeClicked_", delegate=delegate,
                    tooltip=f"Resume: {cs.summary}\nSession: {cs.session_id}\nSize: {cs.size_kb}KB",
                    tree_lines=[(1, tree_kind)],
                ))

        rows.append(_build_separator())

    # ── Unassigned ──
    if data.get("unassigned"):
        rows.append(_build_sidebar_row(
            [("GLOBAL", BOLD, CLR_LABEL), ("  / UNASSIGNED", MONO_SM, CLR_DIM)],
            icon=sf_symbol("globe", color=CLR_SECONDARY, size=11.0),
            is_header=True,
        ))
        unassigned = data["unassigned"]
        for ui, sess in enumerate(unassigned):
            kind = "last" if ui == len(unassigned) - 1 else "mid"
            rows.append(_build_sidebar_row(
                sess["segments"],
                indent=1,
                icon=sf_symbol(
                    sess.get("icon_name", "apple.terminal.fill"),
                    color=sess.get("icon_color", CLR_SECONDARY),
                    size=10.0,
                ),
                tag=sess["tag"], callback="sessionClicked_", delegate=delegate,
                tooltip=sess.get("tooltip"),
                tree_lines=[(1, kind)],
            ))
        rows.append(_build_separator())

    # ── Dev VMs ──
    devvms = data.get("devvms", [])
    if devvms:
        _devvm_tag_counter = 30000
        rows.append(_build_sidebar_row(
            [("DEV VMs", BOLD, CLR_LABEL), (f"  ({len(devvms)})", MONO_SM, CLR_DIM)],
            icon=sf_symbol("server.rack", color=CLR_CYAN, size=11.0),
            is_header=True,
        ))
        rows.append(_build_separator())

        for vi, vm in enumerate(devvms):
            vm_label = vm.vm_name if vm.vm_name != "default" else "dev-vm"
            # State badge
            if vm.state == "running":
                state_seg = ("\u25CF running", BOLD_SM, CLR_GREEN)
            elif vm.state == "stopped":
                state_seg = ("\u25CB stopped", MONO_SM, CLR_DIM)
            elif vm.state == "pending":
                state_seg = ("\u25D4 pending", MONO_SM, CLR_ORANGE)
            elif vm.state == "stopping":
                state_seg = ("\u25D4 stopping", MONO_SM, CLR_ORANGE)
            else:
                state_seg = (vm.state or "unknown", MONO_SM, CLR_DIM)

            vm_segs = [
                (vm_label, BOLD, CLR_ACCENT),
                ("  ", MONO_SM, None),
                state_seg,
            ]
            vm_tooltip = f"VM: {vm.vm_name}\nInstance: {vm.instance_id}\nType: {vm.instance_type}\nState: {vm.state}\nIP: {vm.ip or 'N/A'}"
            has_detail = bool(vm.sessions) or vm.ip
            rows.append(_build_sidebar_row(
                vm_segs,
                icon=sf_symbol("desktopcomputer", color=CLR_CYAN, size=11.0),
                tooltip=vm_tooltip,
            ))
            # Detail row: instance type + IP
            detail_segs = [(vm.instance_type, MONO_SM, CLR_DIM)]
            if vm.ip:
                detail_segs += [("  ", MONO_SM, None), (vm.ip, MONO_SM, CLR_DIM)]
            rows.append(_build_sidebar_row(
                detail_segs,
                indent=1,
                tree_lines=[(1, "mid" if has_detail else "last")],
            ))

            # ET sessions for this VM
            has_dead = any(s.status == "dead" for s in vm.sessions)
            if vm.sessions:
                for si, s in enumerate(vm.sessions):
                    is_last = (si == len(vm.sessions) - 1)
                    if s.status == "attached":
                        status_seg = ("\u25C9 attached", BOLD_SM, CLR_GREEN)
                    elif s.status == "detached":
                        status_seg = ("\u25CB detached", MONO_SM, CLR_ORANGE)
                    elif s.status == "unknown":
                        status_seg = ("? unknown", MONO_SM, CLR_ORANGE)
                    elif s.status == "armed":
                        status_seg = ("\u25c8 armed", BOLD_SM, CLR_CYAN)
                    else:
                        status_seg = ("\u2717 dead", MONO_SM, CLR_RED)

                    age_str = ""
                    if s.last_connected:
                        try:
                            from datetime import datetime
                            lc = datetime.fromisoformat(s.last_connected)
                            age_secs = int((datetime.now() - lc).total_seconds())
                            if age_secs > 0:
                                age_str = format_age(age_secs)
                        except Exception:
                            pass

                    sess_segs = [
                        (s.name, BOLD_SM, CLR_SECONDARY),
                        ("  ", MONO_SM, None),
                        status_seg,
                    ]
                    if s.clients > 0:
                        sess_segs += [("  ", MONO_SM, None), (f"{s.clients} client{'s' if s.clients > 1 else ''}", MONO_SM, CLR_DIM)]
                    if age_str:
                        sess_segs += [("  ", MONO_SM, None), (age_str, MONO_SM, CLR_DIM)]

                    # Click action depends on status + whether we have a local window
                    et_windows = data.get("devvm_et_windows", {})
                    local_win = et_windows.get((vm.ip, s.name))
                    cb = None
                    cb_delegate = None
                    s_tag = 0
                    if local_win and s.status == "attached":
                        # Raise existing iTerm window
                        s_tag = _devvm_tag_counter
                        _devvm_tag_counter += 1
                        delegate._session_map[s_tag] = (local_win[0], local_win[1], None)
                        cb = "sessionClicked_"
                        cb_delegate = delegate
                    elif s.status in ("detached", "unknown", "armed"):
                        # Open new connection (armed: connecting fires the one-shot resume)
                        s_tag = _devvm_tag_counter
                        _devvm_tag_counter += 1
                        delegate._devvm_connect_map[s_tag] = (s.name, vm.vm_name)
                        cb = "devvmConnectClicked_"
                        cb_delegate = delegate

                    tooltip = f"Session: {s.name}\nStatus: {s.status}\nClients: {s.clients}\nConnections: {s.connect_count}"
                    if s.created_at:
                        tooltip += f"\nCreated: {s.created_at}"
                    if s.last_connected:
                        tooltip += f"\nLast connected: {s.last_connected}"
                    if local_win and s.status == "attached":
                        tooltip += "\n\nClick to focus window"
                    elif s.status == "armed":
                        tooltip += "\n\nClick to connect (auto-resumes saved session)"
                    elif s.status in ("detached", "unknown"):
                        tooltip += "\n\nClick to connect"

                    # Last session gets "mid" tree line if cleanup row follows
                    tree_last = is_last and not has_dead

                    rows.append(_build_sidebar_row(
                        sess_segs,
                        indent=1,
                        icon=sf_symbol(
                            "bolt.fill" if s.status == "attached" else
                            "questionmark.circle" if s.status == "unknown" else
                            "arrow.counterclockwise" if s.status == "detached" else
                            "clock.arrow.circlepath" if s.status == "armed" else
                            "xmark.circle",
                            color=CLR_GREEN if s.status == "attached" else CLR_CYAN if s.status == "armed" else CLR_ORANGE if s.status in ("detached", "unknown") else CLR_RED,
                            size=9.0,
                        ),
                        tag=s_tag, callback=cb, delegate=cb_delegate,
                        tooltip=tooltip,
                        tree_lines=[(1, "last" if tree_last else "mid")],
                    ))

                # "Clean up dead sessions" action
                dead_sessions = [s for s in vm.sessions if s.status == "dead"]
                if dead_sessions:
                    cleanup_tag = _devvm_tag_counter
                    _devvm_tag_counter += 1
                    dead_names = [s.name for s in dead_sessions]
                    delegate._devvm_cleanup_map[cleanup_tag] = (dead_names, vm.vm_name)
                    rows.append(_build_sidebar_row(
                        [(f"Clean up {len(dead_sessions)} dead session{'s' if len(dead_sessions) > 1 else ''}", MONO_SM, CLR_DIM)],
                        indent=1,
                        icon=sf_symbol("trash", color=CLR_DIM, size=9.0),
                        tag=cleanup_tag, callback="devvmCleanupClicked_", delegate=delegate,
                        tooltip=f"Kill dead sessions: {', '.join(dead_names)}",
                        tree_lines=[(1, "last")],
                    ))

            rows.append(_build_separator())

    # ── Changes ──
    if data.get("deltas"):
        rows.append(_build_sidebar_row(
            [("CHANGES", BOLD, CLR_LABEL)],
            icon=sf_symbol("arrow.triangle.2.circlepath", color=CLR_ACCENT, size=11.0),
            is_header=True,
        ))
        for line in data["deltas"]:
            if line.startswith("[+]"):
                clr = CLR_GREEN
                ico = sf_symbol("plus.circle.fill", color=CLR_GREEN, size=9.0)
            elif line.startswith("[-]"):
                clr = CLR_ORANGE
                ico = sf_symbol("minus.circle.fill", color=CLR_ORANGE, size=9.0)
            else:
                clr = CLR_ACCENT
                ico = sf_symbol("arrow.right.circle.fill", color=CLR_ACCENT, size=9.0)
            rows.append(_build_sidebar_row(
                [(line[:3], BOLD_SM, clr), (line[3:], MONO_SM, CLR_SECONDARY)],
                indent=1, icon=ico,
            ))
        rows.append(_build_separator())

    # ── Insights ──
    rows.append(_build_sidebar_row(
        [("SYSTEM INSIGHTS", BOLD, CLR_LABEL)],
        icon=sf_symbol("chart.bar.fill", color=CLR_ORANGE, size=11.0),
        is_header=True,
    ))
    for line in data.get("insights", []):
        segments = build_insight_segments(line)
        if line.startswith("[!]"):
            ico = sf_symbol("exclamationmark.triangle.fill", color=CLR_ORANGE, size=9.0)
        else:
            ico = sf_symbol("info.circle.fill", color=CLR_ACCENT, size=9.0)
        rows.append(_build_sidebar_row(segments, indent=1, icon=ico))

    # ── Summary ──
    rows.append(_build_separator())
    rows.append(_build_sidebar_row(data.get("summary_segments", []), indent=0))

    # ── Quit ──
    rows.append(_build_separator())
    rows.append(_build_sidebar_row(
        [("Quit", MONO_SM, CLR_DIM)],
        icon=sf_symbol("power", color=CLR_DIM, size=9.0),
        tag=-1, callback="quitClicked_", delegate=delegate,
    ))

    return rows


# ── App Delegate ──────────────────────────────────────────────────────────────

def _any_terminal_running():
    """Check if any tracked terminal app is currently running."""
    for app in NSWorkspace.sharedWorkspace().runningApplications():
        bid = app.bundleIdentifier()
        if bid and bid in TERMINAL_BUNDLE_IDS:
            return True
    return False


class AppDelegate(NSObject):
    _status_item = objc.ivar()
    _sidebar_window = objc.ivar()
    _sidebar_scroll = objc.ivar()
    _sidebar_container = objc.ivar()
    _sidebar_strip = objc.ivar()
    _sidebar_expanded = objc.ivar()
    _sidebar_visible = objc.ivar()
    _hover_enter_time = objc.ivar()
    _hover_exit_time = objc.ivar()
    _mouse_poll_timer = objc.ivar()
    _cached_data = objc.ivar()
    _session_map = objc.ivar()
    _project_window_map = objc.ivar()
    _companion_map = objc.ivar()
    _resume_map = objc.ivar()
    _devvm_connect_map = objc.ivar()
    _devvm_cleanup_map = objc.ivar()
    _open_companion_map = objc.ivar()
    _next_companion_tag = objc.ivar()
    _prev_snapshot = objc.ivar()
    _lock = objc.ivar()
    _refresh_timer = objc.ivar()

    def applicationDidFinishLaunching_(self, notification):
        init_fonts_and_colors()

        self._cached_data = None
        self._session_map = {}
        self._project_window_map = {}
        self._companion_map = {}
        self._resume_map = {}
        self._devvm_connect_map = {}
        self._devvm_cleanup_map = {}
        self._open_companion_map = {}
        self._next_companion_tag = 10000
        self._prev_snapshot = None
        self._lock = threading.Lock()
        self._sidebar_expanded = False
        self._sidebar_visible = False
        self._hover_enter_time = None
        self._hover_exit_time = None

        status_bar = NSStatusBar.systemStatusBar()
        self._status_item = status_bar.statusItemWithLength_(NSVariableStatusItemLength)

        bar_icon = sf_symbol("terminal.fill", size=14.0)
        if bar_icon:
            bar_icon.setTemplate_(True)
            self._status_item.button().setImage_(bar_icon)
        else:
            self._status_item.setTitle_(">_")

        menu = NSMenu.alloc().init()
        menu.setDelegate_(self)
        self._status_item.setMenu_(menu)

        # ── Create sidebar window ──
        self._create_sidebar()

        # ── Workspace observers for app launch/quit ──
        ws = NSWorkspace.sharedWorkspace()
        nc = ws.notificationCenter()
        nc.addObserver_selector_name_object_(
            self, "_appLaunched:", "NSWorkspaceDidLaunchApplicationNotification", None,
        )
        nc.addObserver_selector_name_object_(
            self, "_appTerminated:", "NSWorkspaceDidTerminateApplicationNotification", None,
        )
        nc.addObserver_selector_name_object_(
            self, "_spaceChanged:", "NSWorkspaceActiveSpaceDidChangeNotification", None,
        )

        # Initial visibility check
        if _any_terminal_running():
            self._show_sidebar()
        else:
            self._hide_sidebar()

        self._start_refresh()

        self._refresh_timer = NSTimer.scheduledTimerWithTimeInterval_target_selector_userInfo_repeats_(
            30.0, self, "timerRefresh:", None, True
        )

        # Mouse position poll for auto-hide (NSTrackingArea doesn't work for accessory apps)
        self._mouse_poll_timer = NSTimer.scheduledTimerWithTimeInterval_target_selector_userInfo_repeats_(
            0.05, self, "_pollMouse:", None, True
        )

    def _create_sidebar(self):
        screen = NSScreen.mainScreen().visibleFrame()
        # Start collapsed: 8px hit zone on left edge
        win_rect = NSMakeRect(screen.origin.x, screen.origin.y, SIDEBAR_COLLAPSED_WIDTH, screen.size.height)

        # NSPanel with nonactivating mask — won't steal focus from terminals
        style = 0 | (1 << 7)  # borderless | NSWindowStyleMaskNonactivatingPanel
        win = NSPanel.alloc().initWithContentRect_styleMask_backing_defer_(
            win_rect, style, NSBackingStoreBuffered, False,
        )
        win.setLevel_(3)  # NSFloatingWindowLevel
        win.setCollectionBehavior_(
            (1 << 0) | (1 << 4)  # canJoinAllSpaces | stationary
        )
        win.setHasShadow_(False)
        win.setOpaque_(False)
        win.setBackgroundColor_(NSColor.clearColor())
        win.setFloatingPanel_(True)
        win.setBecomesKeyOnlyIfNeeded_(True)
        win.setHidesOnDeactivate_(False)

        content = win.contentView()
        full_rect = NSMakeRect(0, 0, SIDEBAR_WIDTH, screen.size.height)

        # ── Vibrancy background (hidden when collapsed to avoid blue bleed) ──
        effect_view = NSVisualEffectView.alloc().initWithFrame_(full_rect)
        effect_view.setMaterial_(7)  # NSVisualEffectMaterialSidebar
        effect_view.setBlendingMode_(0)  # behindWindow
        effect_view.setState_(1)  # active
        effect_view.setAutoresizingMask_(18)  # width + height flexible
        effect_view.setHidden_(True)
        content.addSubview_(effect_view)
        self._sidebar_effect_view = effect_view

        # ── Scroll view with content (always present, clipped by window width) ──
        scroll = NSScrollView.alloc().initWithFrame_(full_rect)
        scroll.setHasVerticalScroller_(True)
        scroll.setHasHorizontalScroller_(False)
        scroll.setAutoresizingMask_(18)
        scroll.setDrawsBackground_(False)
        scroll.setAutomaticallyAdjustsContentInsets_(False)

        container = FlippedView.alloc().initWithFrame_(NSMakeRect(0, 0, SIDEBAR_WIDTH, 0))
        scroll.setDocumentView_(container)
        content.addSubview_(scroll)

        # ── Accent strip (topmost — 2px accent, visible when collapsed) ──
        strip = NSView.alloc().initWithFrame_(NSMakeRect(0, 0, SIDEBAR_STRIP_WIDTH, screen.size.height))
        strip.setWantsLayer_(True)
        strip.layer().setBackgroundColor_(NSColor.controlAccentColor().colorWithAlphaComponent_(0.8).CGColor())
        strip.setAutoresizingMask_(16)  # height flexible
        content.addSubview_(strip)
        self._sidebar_strip = strip

        self._sidebar_window = win
        self._sidebar_scroll = scroll
        self._sidebar_container = container

    def _updateSidebar(self):
        with self._lock:
            data = self._cached_data

        container = self._sidebar_container
        if container is None:
            return

        # Save scroll position before rebuilding
        clip = self._sidebar_scroll.contentView()
        saved_origin = clip.bounds().origin

        # Remove all existing subviews
        for view in list(container.subviews()):
            view.removeFromSuperview()

        # Build new rows and lay them out top-to-bottom
        rows = build_sidebar_content(data, self)
        y = 4  # top padding
        width = max(SIDEBAR_WIDTH, int(clip.bounds().size.width))
        for row in rows:
            # Get the row's intrinsic height from its constraint or frame
            h = int(row.frame().size.height) or 22
            row.setFrame_(NSMakeRect(0, y, width, h))
            row.setTranslatesAutoresizingMaskIntoConstraints_(True)
            container.addSubview_(row)
            y += h

        # Resize container to fit all content
        container.setFrameSize_((width, y + 4))

        # Restore scroll position (clamped to new content height)
        max_y = max(0, (y + 4) - clip.bounds().size.height)
        restored_y = min(saved_origin.y, max_y)
        clip.scrollToPoint_((0, restored_y))
        self._sidebar_scroll.reflectScrolledClipView_(clip)

    # ── Auto-hide: expand / collapse ──

    # ── Auto-hide: poll mouse position ──
    # NSTrackingArea doesn't work for accessory-policy borderless windows,
    # so we poll at 50ms (like macOS Dock does internally).

    def _pollMouse_(self, timer):
        """Check mouse position and expand/collapse sidebar accordingly."""
        if not self._sidebar_visible:
            return

        mouse = NSEvent.mouseLocation()
        win = self._sidebar_window
        frame = win.frame()

        in_zone = NSPointInRect(mouse, frame)

        if in_zone and not self._sidebar_expanded:
            # Hover delay: require mouse to stay in zone
            now = time.monotonic()
            if self._hover_enter_time is None:
                self._hover_enter_time = now
            elif now - self._hover_enter_time >= SIDEBAR_HOVER_DELAY:
                self._expandSidebar()
        elif not in_zone:
            self._hover_enter_time = None
            if self._sidebar_expanded:
                now = time.monotonic()
                if self._hover_exit_time is None:
                    self._hover_exit_time = now
                elif now - self._hover_exit_time >= SIDEBAR_EXIT_DELAY:
                    self._collapseSidebar()
            else:
                self._hover_exit_time = None

        if in_zone:
            self._hover_exit_time = None

    def _expandSidebar(self):
        """Animate sidebar to full width."""
        self._sidebar_expanded = True
        win = self._sidebar_window
        screen = NSScreen.mainScreen().visibleFrame()

        self._sidebar_strip.setHidden_(True)
        self._sidebar_effect_view.setHidden_(False)

        NSAnimationContext.beginGrouping()
        NSAnimationContext.currentContext().setDuration_(SIDEBAR_ANIM_DURATION)
        win.animator().setFrame_display_(NSMakeRect(screen.origin.x, screen.origin.y, SIDEBAR_WIDTH, screen.size.height), True)
        NSAnimationContext.endGrouping()

        win.setHasShadow_(True)

    def _collapseSidebar(self):
        """Animate sidebar back to collapsed strip."""
        self._sidebar_expanded = False
        win = self._sidebar_window
        screen = NSScreen.mainScreen().visibleFrame()

        win.setHasShadow_(False)
        strip = self._sidebar_strip

        effect_view = self._sidebar_effect_view

        def completion_handler():
            if not self._sidebar_expanded:
                strip.setHidden_(False)
                effect_view.setHidden_(True)

        NSAnimationContext.beginGrouping()
        ctx = NSAnimationContext.currentContext()
        ctx.setDuration_(SIDEBAR_ANIM_DURATION)
        ctx.setCompletionHandler_(completion_handler)
        win.animator().setFrame_display_(NSMakeRect(screen.origin.x, screen.origin.y, SIDEBAR_COLLAPSED_WIDTH, screen.size.height), True)
        NSAnimationContext.endGrouping()

    # ── App tracking: show/hide based on running terminals ──

    def _show_sidebar(self):
        """Show the collapsed sidebar strip."""
        if self._sidebar_visible:
            return
        self._sidebar_visible = True
        self._sidebar_window.orderFront_(None)

    def _hide_sidebar(self):
        """Hide sidebar entirely (no terminal apps running)."""
        self._sidebar_visible = False
        self._sidebar_expanded = False
        self._sidebar_window.orderOut_(None)

    def _appLaunched_(self, notification):
        app = notification.userInfo()["NSWorkspaceApplicationKey"]
        bid = app.bundleIdentifier()
        if bid and bid in TERMINAL_BUNDLE_IDS:
            self._show_sidebar()
            self._start_refresh()

    def _appTerminated_(self, notification):
        app = notification.userInfo()["NSWorkspaceApplicationKey"]
        bid = app.bundleIdentifier()
        if bid and bid in TERMINAL_BUNDLE_IDS:
            # Check if any other terminal is still running
            if not _any_terminal_running():
                self._hide_sidebar()

    def _spaceChanged_(self, notification):
        """Re-evaluate sidebar visibility on space change."""
        if _any_terminal_running():
            self._show_sidebar()
        else:
            self._hide_sidebar()

    def timerRefresh_(self, timer):
        self._start_refresh()

    def _start_refresh(self):
        thread = threading.Thread(target=self._bg_refresh, daemon=True)
        thread.start()

    def _bg_refresh(self):
        with self._lock:
            prev = self._prev_snapshot
        data, session_map, project_window_map, snapshot = collect_menu_data(prev_snapshot=prev)
        with self._lock:
            self._cached_data = data
            self._session_map = session_map
            self._project_window_map = project_window_map
            if snapshot is not None:
                self._prev_snapshot = snapshot
        self.performSelectorOnMainThread_withObject_waitUntilDone_("_updateUI", None, False)

    def _updateUI(self):
        self._updateMenu()
        self._updateSidebar()

    def _updateMenu(self):
        with self._lock:
            data = self._cached_data

        # Clear maps that will be repopulated (sidebar clears its own in build_sidebar_content)
        self._resume_map = {}
        self._devvm_connect_map = {}
        self._devvm_cleanup_map = {}

        menu = NSMenu.alloc().init()
        menu.setDelegate_(self)
        menu.setAutoenablesItems_(False)

        if data is None:
            loading = rich_text([("Loading...", MONO_SM, CLR_DIM)])
            menu.addItem_(make_item(loading))
            self._status_item.setMenu_(menu)
            return

        # ── Workspaces header ──
        header_text = rich_text([
            ("WORKSPACES", BOLD, CLR_LABEL),
            (f"  ({len(data['projects'])})", MONO_SM, CLR_DIM),
        ])
        header_icon = sf_symbol("square.grid.2x2.fill", color=CLR_ACCENT, size=12.0)
        menu.addItem_(make_item(header_text, image=header_icon))
        menu.addItem_(NSMenuItem.separatorItem())

        _menu_resume_tag = 20000

        for proj in data["projects"]:
            # ── Companion app indicators ──
            companion_apps = proj.get("companion_apps", [])
            companion_suffix = ""
            if companion_apps:
                app_abbrevs = {"BBEdit": "BB", "PyCharm": "Py", "Finder": "F"}
                labels = [app_abbrevs.get(a, a) for a in sorted(companion_apps)]
                companion_suffix = "  " + " ".join(labels)

            header_segs = list(proj["header_segments"])
            if companion_suffix:
                header_segs.append((companion_suffix, MONO_SM, CLR_DIM))
            proj_text = rich_text(header_segs)
            folder_icon = sf_symbol("folder.fill", color=CLR_ACCENT, size=12.0)
            item = make_item(
                proj_text, action="projectClicked:", target=self,
                tag=proj["tag"], image=folder_icon,
                tooltip=f"{proj['path']}\n{proj['session_count']} sessions, {proj['claude_count']} Claude",
            )
            item.setEnabled_(True)
            menu.addItem_(item)

            # ── Git status row ──
            git_segs = proj.get("git_segments")
            if git_segs:
                git_text = rich_text(git_segs)
                git_icon = sf_symbol("arrow.triangle.branch", color=CLR_DIM, size=10.0)
                menu.addItem_(make_item(git_text, indent=1, image=git_icon))

            for sess in proj["sessions"]:
                if sess.get("type") == "subheader":
                    sub_text = rich_text([
                        ("\u25B8 ", MONO_SM, CLR_DIM),
                        (sess["name"] + "/", BOLD_SM, CLR_ACCENT),
                    ])
                    sub_icon = sf_symbol("folder", color=CLR_DIM, size=10.0)
                    sub_item = make_item(
                        sub_text, indent=1, image=sub_icon,
                        action="projectClicked:", target=self,
                        tag=sess["tag"],
                    )
                    sub_item.setEnabled_(True)
                    menu.addItem_(sub_item)
                    continue

                indent = 2 if sess.get("in_subgroup") else 1
                sess_text = rich_text(sess["segments"])
                sess_icon = sf_symbol(
                    sess.get("icon_name", "apple.terminal.fill"),
                    color=sess.get("icon_color", CLR_SECONDARY),
                    size=11.0,
                )
                item = make_item(
                    sess_text, indent=indent, action="sessionClicked:", target=self,
                    tag=sess["tag"], image=sess_icon, tooltip=sess["tooltip"],
                )
                item.setEnabled_(True)
                menu.addItem_(item)

            # ── Resumable Claude sessions ──
            for cs in proj.get("resumable", []):
                age_secs = time.time() - cs.timestamp
                age_str = format_age(int(age_secs))
                summary = cs.summary
                if len(summary) > 40:
                    summary = summary[:39] + "\u2026"
                segs = [
                    ("\u25B7 ", MONO_SM, CLR_DIM),
                    (summary + "  ", MONO_SM, CLR_SECONDARY),
                    (age_str, MONO_SM, CLR_DIM),
                ]
                resume_icon = sf_symbol("arrow.counterclockwise", color=CLR_DIM, size=10.0)
                r_tag = _menu_resume_tag
                _menu_resume_tag += 1
                self._resume_map[r_tag] = (cs.session_id, cs.project_path)
                r_item = make_item(
                    rich_text(segs), indent=1, image=resume_icon,
                    action="resumeClicked:", target=self, tag=r_tag,
                    tooltip=f"Resume: {cs.summary}\nSession: {cs.session_id}\nSize: {cs.size_kb}KB",
                )
                r_item.setEnabled_(True)
                menu.addItem_(r_item)

            menu.addItem_(NSMenuItem.separatorItem())

        # ── Unassigned ──
        if data["unassigned"]:
            unassigned_text = rich_text([
                ("GLOBAL", BOLD, CLR_LABEL),
                ("  / UNASSIGNED", MONO_SM, CLR_DIM),
            ])
            globe_icon = sf_symbol("globe", color=CLR_SECONDARY, size=12.0)
            menu.addItem_(make_item(unassigned_text, image=globe_icon))

            for sess in data["unassigned"]:
                sess_text = rich_text(sess["segments"])
                sess_icon = sf_symbol(
                    sess.get("icon_name", "apple.terminal.fill"),
                    color=sess.get("icon_color", CLR_SECONDARY),
                    size=11.0,
                )
                item = make_item(
                    sess_text, indent=1, action="sessionClicked:", target=self,
                    tag=sess["tag"], image=sess_icon, tooltip=sess["tooltip"],
                )
                item.setEnabled_(True)
                menu.addItem_(item)

            menu.addItem_(NSMenuItem.separatorItem())

        # ── Dev VMs ──
        _menu_devvm_tag = 30000
        devvms = data.get("devvms", [])
        if devvms:
            vm_header = rich_text([
                ("DEV VMs", BOLD, CLR_LABEL),
                (f"  ({len(devvms)})", MONO_SM, CLR_DIM),
            ])
            menu.addItem_(make_item(vm_header, image=sf_symbol("server.rack", color=CLR_CYAN, size=12.0)))

            for vm in devvms:
                vm_label = vm.vm_name if vm.vm_name != "default" else "dev-vm"
                state_str = f"\u25CF {vm.state}" if vm.state == "running" else f"\u25CB {vm.state}"
                state_clr = CLR_GREEN if vm.state == "running" else CLR_DIM
                vm_segs = [
                    (vm_label, BOLD_SM, CLR_ACCENT),
                    ("  ", MONO_SM, None),
                    (state_str, MONO_SM, state_clr),
                ]
                vm_text = rich_text(vm_segs)
                menu.addItem_(make_item(vm_text, indent=1, image=sf_symbol("desktopcomputer", color=CLR_CYAN, size=11.0)))
                # Detail line: instance type + IP
                detail_segs = [(vm.instance_type, MONO_SM, CLR_DIM)]
                if vm.ip:
                    detail_segs += [("  ", MONO_SM, None), (vm.ip, MONO_SM, CLR_DIM)]
                menu.addItem_(make_item(rich_text(detail_segs), indent=2))

                for s in vm.sessions:
                    if s.status == "attached":
                        s_clr = CLR_GREEN
                        s_icon = "bolt.fill"
                        s_label = "\u25C9 attached"
                    elif s.status == "detached":
                        s_clr = CLR_ORANGE
                        s_icon = "arrow.counterclockwise"
                        s_label = "\u25CB detached"
                    elif s.status == "unknown":
                        s_clr = CLR_ORANGE
                        s_icon = "questionmark.circle"
                        s_label = "? unknown"
                    elif s.status == "armed":
                        s_clr = CLR_CYAN
                        s_icon = "clock.arrow.circlepath"
                        s_label = "\u25c8 armed"
                    else:
                        s_clr = CLR_RED
                        s_icon = "xmark.circle"
                        s_label = "\u2717 dead"
                    s_segs = [
                        (s.name, BOLD_SM, CLR_SECONDARY),
                        ("  ", MONO_SM, None),
                        (s_label, MONO_SM, s_clr),
                    ]
                    s_text = rich_text(s_segs)
                    et_windows = data.get("devvm_et_windows", {})
                    local_win = et_windows.get((vm.ip, s.name))
                    if local_win and s.status == "attached":
                        # Raise existing window
                        s_tag = _menu_devvm_tag
                        _menu_devvm_tag += 1
                        self._session_map[s_tag] = (local_win[0], local_win[1], None)
                        item = make_item(
                            s_text, indent=2,
                            image=sf_symbol(s_icon, color=s_clr, size=10.0),
                            action="sessionClicked:", target=self, tag=s_tag,
                            tooltip=f"Focus window for '{s.name}'",
                        )
                        item.setEnabled_(True)
                    elif s.status in ("detached", "unknown", "armed"):
                        s_tag = _menu_devvm_tag
                        _menu_devvm_tag += 1
                        self._devvm_connect_map[s_tag] = (s.name, vm.vm_name)
                        item = make_item(
                            s_text, indent=2,
                            image=sf_symbol(s_icon, color=s_clr, size=10.0),
                            action="devvmConnectClicked:", target=self, tag=s_tag,
                            tooltip=(f"Click to resume '{s.name}'" if s.status == "armed" else f"Click to connect to '{s.name}'"),
                        )
                        item.setEnabled_(True)
                    else:
                        item = make_item(s_text, indent=2, image=sf_symbol(s_icon, color=s_clr, size=10.0))
                    menu.addItem_(item)

                # "Clean up dead" in menu
                dead_sessions = [s for s in vm.sessions if s.status == "dead"]
                if dead_sessions:
                    cleanup_tag = _menu_devvm_tag
                    _menu_devvm_tag += 1
                    dead_names = [s.name for s in dead_sessions]
                    self._devvm_cleanup_map[cleanup_tag] = (dead_names, vm.vm_name)
                    cleanup_text = rich_text([
                        (f"Clean up {len(dead_sessions)} dead session{'s' if len(dead_sessions) > 1 else ''}", MONO_SM, CLR_DIM),
                    ])
                    cleanup_item = make_item(
                        cleanup_text, indent=2,
                        image=sf_symbol("trash", color=CLR_DIM, size=10.0),
                        action="devvmCleanupClicked:", target=self, tag=cleanup_tag,
                    )
                    cleanup_item.setEnabled_(True)
                    menu.addItem_(cleanup_item)

            menu.addItem_(NSMenuItem.separatorItem())

        # ── Changes Since Last Refresh ──
        if data.get("deltas"):
            changes_text = rich_text([("CHANGES", BOLD, CLR_LABEL)])
            changes_icon = sf_symbol("arrow.triangle.2.circlepath", color=CLR_ACCENT, size=12.0)
            menu.addItem_(make_item(changes_text, image=changes_icon))

            for line in data["deltas"]:
                if line.startswith("[+]"):
                    clr = CLR_GREEN
                    ico = sf_symbol("plus.circle.fill", color=CLR_GREEN, size=10.0)
                elif line.startswith("[-]"):
                    clr = CLR_ORANGE
                    ico = sf_symbol("minus.circle.fill", color=CLR_ORANGE, size=10.0)
                else:
                    clr = CLR_ACCENT
                    ico = sf_symbol("arrow.right.circle.fill", color=CLR_ACCENT, size=10.0)
                segments = [(line[:3], BOLD_SM, clr), (line[3:], MONO_SM, CLR_SECONDARY)]
                line_text = rich_text(segments)
                menu.addItem_(make_item(line_text, indent=1, image=ico))

            menu.addItem_(NSMenuItem.separatorItem())

        # ── System Insights ──
        insights_text = rich_text([("SYSTEM INSIGHTS", BOLD, CLR_LABEL)])
        insights_icon = sf_symbol("chart.bar.fill", color=CLR_ORANGE, size=12.0)
        menu.addItem_(make_item(insights_text, image=insights_icon))

        for line in data["insights"]:
            segments = build_insight_segments(line)
            line_text = rich_text(segments)
            if line.startswith("[!]"):
                ico = sf_symbol("exclamationmark.triangle.fill", color=CLR_ORANGE, size=10.0)
            else:
                ico = sf_symbol("info.circle.fill", color=CLR_ACCENT, size=10.0)
            menu.addItem_(make_item(line_text, indent=1, image=ico))

        menu.addItem_(NSMenuItem.separatorItem())

        # ── Summary ──
        summary_text = rich_text(data["summary_segments"])
        menu.addItem_(make_item(summary_text, indent=1))

        menu.addItem_(NSMenuItem.separatorItem())
        quit_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_("Quit", "terminate:", "q")
        menu.addItem_(quit_item)

        self._status_item.setMenu_(menu)

    def sessionClicked_(self, sender):
        tag = sender.tag()
        with self._lock:
            entry = self._session_map.get(tag)
        if entry is not None:
            window_id, app, cwd = entry
            threading.Thread(target=raise_app_window, args=(window_id, app), daemon=True).start()

    def projectClicked_(self, sender):
        tag = sender.tag()
        with self._lock:
            entry = self._project_window_map.get(tag, None)
        if entry:
            window_ids, app = entry
            threading.Thread(target=raise_app_windows, args=(window_ids, app), daemon=True).start()

    def companionClicked_(self, sender):
        tag = sender.tag()
        with self._lock:
            entry = self._companion_map.get(tag)
        if entry:
            bundle_id, app_name, proj_path = entry
            threading.Thread(
                target=_raise_companion_app, args=(bundle_id, app_name, proj_path),
                daemon=True,
            ).start()

    def resumeClicked_(self, sender):
        tag = sender.tag()
        with self._lock:
            entry = self._resume_map.get(tag)
        if entry:
            session_id, project_path = entry
            threading.Thread(
                target=resume_claude_session, args=(session_id, project_path),
                daemon=True,
            ).start()

    def openCompanionClicked_(self, sender):
        tag = sender.tag()
        with self._lock:
            entry = self._open_companion_map.get(tag)
        if entry:
            bundle_id, app_name, folder_path = entry
            threading.Thread(
                target=_open_companion_app, args=(bundle_id, app_name, folder_path),
                daemon=True,
            ).start()

    def devvmConnectClicked_(self, sender):
        tag = sender.tag()
        with self._lock:
            entry = self._devvm_connect_map.get(tag)
        if entry:
            session_name, vm_name = entry
            threading.Thread(
                target=connect_devvm_session, args=(session_name, vm_name),
                daemon=True,
            ).start()

    def devvmCleanupClicked_(self, sender):
        tag = sender.tag()
        with self._lock:
            entry = self._devvm_cleanup_map.get(tag)
        if entry:
            session_names, vm_name = entry
            def _cleanup_and_refresh():
                cleanup_devvm_dead_sessions(session_names, vm_name)
                self._start_refresh()
            threading.Thread(target=_cleanup_and_refresh, daemon=True).start()

    def quitClicked_(self, sender):
        NSApplication.sharedApplication().terminate_(None)

    def menuWillOpen_(self, menu):
        self._start_refresh()


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    app = NSApplication.sharedApplication()
    app.setActivationPolicy_(NSApplicationActivationPolicyAccessory)

    delegate = AppDelegate.alloc().init()
    app.setDelegate_(delegate)

    app.run()


if __name__ == "__main__":
    main()
