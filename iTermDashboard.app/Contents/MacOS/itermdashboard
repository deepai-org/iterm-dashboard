SHELL_NAMES = {"bash", "zsh", "-bash", "-zsh", "fish", "-fish", "sh", "-sh"}
SKIP_CMDS = {"login", "-bash", "-zsh", "bash", "zsh", "fish", "-fish", "sh", "-sh"}

REMOTE_PATTERNS = [
    (re.compile(r'^ssh\s+(.+)'), "ssh"),
    (re.compile(r'^mosh\s+(.+)'), "mosh"),
    (re.compile(r'^et\s+(.+)'), "et"),
    (re.compile(r'^kubectl\s+.*exec\s+.*?(-it?\s+)?(\S+)'), "kubectl"),
    (re.compile(r'^docker\s+exec\s+.*?(-it?\s+)?(\S+)'), "docker"),
    (re.compile(r'^psql\b(.*)'), "psql"),
    (re.compile(r'^mysql\b(.*)'), "mysql"),
    (re.compile(r'^redis-cli\b(.*)'), "redis"),
    (re.compile(r'^mongo\b(.*)'), "mongo"),
]

PROD_KEYWORDS = {"prod", "production", "prd", "live", "primary"}

ROLE_PATTERNS = {
    "editor": {"vim", "nvim", "vi", "nano", "emacs", "code", "hx", "helix", "micro"},
    "agent": {"claude", "aider", "cursor", "copilot"},
    "build": {"make", "cargo", "go", "gcc", "g++", "clang", "cmake", "swift", "swiftc",
              "xcodebuild", "npm", "yarn", "pnpm", "bun", "webpack", "vite", "tsc", "rustc"},
    "test": {"pytest", "jest", "mocha", "cargo-test", "go-test", "rspec", "phpunit",
             "xctest", "swift-test"},
    "logs": {"tail", "less", "more", "bat", "lnav", "stern"},
    "server": {"node", "python", "ruby", "uvicorn", "gunicorn", "flask", "django",
               "rails", "next", "hugo", "serve", "http-server", "live-server"},
}


def _deepest_foreground(shell_pid, procs):
    """Walk the process tree from shell_pid to find the deepest foreground child."""
    children = defaultdict(list)
    pid_to_proc = {}
    for p in procs:
        pid_to_proc[p["pid"]] = p
        children[p["ppid"]].append(p)

    current = shell_pid
    while True:
        kids = children.get(current, [])
        if not kids:
            break
        # Prefer the child with highest CPU, then most RSS (likely the interactive one)
        kids.sort(key=lambda c: (-c["cpu"], -c["rss"]))
        current = kids[0]["pid"]

    proc = pid_to_proc.get(current)
    if proc and current != shell_pid:
        return proc
    return None


def _classify_role(cmd_base, full_cmd):
    """Classify a command into a session role."""
    for role, names in ROLE_PATTERNS.items():
        if cmd_base in names:
            # Distinguish cargo build vs cargo test
            if cmd_base == "cargo" and "test" in full_cmd:
                return "test"
            if cmd_base == "go" and "test" in full_cmd:
                return "test"
            return role
    return "shell"


def _detect_remote(full_cmd):
    """Detect remote session context from a command string. Returns (type, target, is_prod)."""
    cmd_base = full_cmd.split()[0] if full_cmd else ""
    for pattern, rtype in REMOTE_PATTERNS:
        m = pattern.match(full_cmd)
        if m:
            target = m.group(m.lastindex) if m.lastindex else ""
            target = target.strip().split()[-1] if target.strip() else ""
            # Strip user@ from ssh targets
            if "@" in target:
                target = target.split("@")[-1]
            # Remove flags
            if target.startswith("-"):
                target = ""
            is_prod = any(kw in full_cmd.lower() for kw in PROD_KEYWORDS)
            return rtype, target, is_prod
    return "", "", False


def enrich_sessions(sessions):
    tty_map = {}
    nexus_no_tty = []  # Nexus sessions without a TTY (builtins)
    for s in sessions:
        if s.tty:
            short_tty = s.tty.replace("/dev/", "")
            tty_map[short_tty] = s
        elif s.app_source == "Nexus":
            nexus_no_tty.append(s)

    # Enrich Nexus builtin sessions (no TTY) from their AppleScript-provided data
    for s in nexus_no_tty:
        cmd = s.running_command
        if cmd:
            cmd_base = os.path.basename(cmd.split()[0]) if cmd.split() else ""
            s.fg_command = cmd_base
            s.role = _classify_role(cmd_base, cmd)
            rtype, rtarget, is_prod = _detect_remote(cmd)
            if rtype:
                s.remote_type = rtype
                s.remote_target = rtarget
                s.is_production = is_prod
                s.role = "remote"
            if "claude" in cmd.lower():
                s.is_claude = True
                s.role = "agent"

    ps_output = run_args(["ps", "-eo", "tty=,pid=,ppid=,pcpu=,rss=,etime=,command="])
    tty_procs = defaultdict(list)
    for line in ps_output.splitlines():
        parts = line.split(None, 6)
        if len(parts) < 7:
            continue
        tty, pid, ppid, cpu, rss, etime, cmd = parts
        tty_procs[tty].append({
            "pid": int(pid), "ppid": int(ppid),
            "cpu": float(cpu), "rss": int(rss),
            "etime": etime.strip(), "cmd": cmd.strip(),
        })

    shell_pids = {}
    now = time.time()

    for tty_name, sess in tty_map.items():
        procs = tty_procs.get(tty_name, [])
        sess.processes = procs

        # Find shell process
        shell_pid = None
        for p in procs:
            base = p["cmd"].split()[0]
            if base in SHELL_NAMES:
                shell_pids[p["pid"]] = tty_name
                sess.uptime = p["etime"]
                shell_pid = p["pid"]
                break
        else:
            for p in procs:
                if "login" in p["cmd"]:
                    sess.uptime = p["etime"]
                    break

        # Foreground command inference — walk to deepest child
        if shell_pid:
            fg_proc = _deepest_foreground(shell_pid, procs)
            if fg_proc:
                fg_full = fg_proc["cmd"]
                fg_parts = fg_full.split()
                fg_base = os.path.basename(fg_parts[0]) if fg_parts else ""
                sess.fg_command = fg_base
                sess.fg_args = " ".join(fg_parts[1:3]) if len(fg_parts) > 1 else ""
                sess.running_command = fg_base

                # Remote detection on the foreground command
                rtype, rtarget, is_prod = _detect_remote(fg_full)
                if rtype:
                    sess.remote_type = rtype
                    sess.remote_target = rtarget
                    sess.is_production = is_prod
                    sess.role = "remote"
                else:
                    sess.role = _classify_role(fg_base, fg_full)
        elif not procs:
            sess.activity_state = "zombie"

        # Detect Claude instances
        for p in procs:
            if p["cmd"].startswith("claude"):
                sess.is_claude = True
                sess.mem_kb = p["rss"]
                sess.cpu = p["cpu"]
                sess.role = "agent"
                break

        # Detect LSP servers
        for p in procs:
            if "sourcekit-lsp" in p["cmd"]:
                if not sess.running_command:
                    sess.running_command = "sourcekit-lsp"
                break

        # TTY idle detection via device mtime
        try:
            tty_path = f"/dev/{tty_name}"
            mtime = os.stat(tty_path).st_mtime
            sess.idle_secs = int(now - mtime)
        except OSError:
            sess.idle_secs = 0

        # Activity state classification
        if sess.activity_state != "zombie":
            has_fg = bool(sess.fg_command) and sess.fg_command not in SHELL_NAMES
            if has_fg or sess.idle_secs < 60:
                sess.activity_state = "active"
            elif sess.idle_secs < 1800:
                sess.activity_state = "idle"
            else:
                uptime_secs = parse_etime(sess.uptime) if sess.uptime else 0
                # Zombie: only shell procs remain, idle >30m, uptime >1d
                # Catches dead Claude sessions (task name in window title, process gone)
                only_shell = not has_fg and not sess.is_claude
                if only_shell and sess.idle_secs > 1800 and uptime_secs > 86400:
                    sess.activity_state = "zombie"
                elif uptime_secs > 5 * 86400 and sess.idle_secs > 43200:
                    sess.activity_state = "zombie"
                else:
                    sess.activity_state = "stale"

        sess.window_name = strip_iterm_prefix(sess.window_name)
        sess.session_name = strip_iterm_prefix(sess.session_name)

    # Batch lsof for CWDs
    if shell_pids:
        pid_csv = ",".join(str(p) for p in shell_pids)
        lsof_out = run_args(["lsof", "-a", "-d", "cwd", "-p", pid_csv, "-Fpn"], timeout=10)
        current_pid = None
        for line in lsof_out.splitlines():
            if line.startswith("p"):
                current_pid = int(line[1:])
            elif line.startswith("n") and current_pid is not None:
                path = line[1:]
                tty_name = shell_pids.get(current_pid)
                if tty_name and tty_name in tty_map:
                    # Don't overwrite cwd already provided by the app (e.g. Nexus)
                    if not tty_map[tty_name].cwd:
                        tty_map[tty_name].cwd = path
                current_pid = None


def find_git_root(path):
    """Walk up from path to find the nearest .git directory or file (worktree)."""
    current = path
    while True:
        dot_git = os.path.join(current, ".git")
        if os.path.isdir(dot_git) or os.path.isfile(dot_git):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return None
        current = parent


def get_git_status(path):
    gs = GitStatus()
    git_root = find_git_root(path)
    if git_root is None:
        return gs
    gs.is_git = True
    path = git_root

    # Check if this is a worktree (has .git file instead of .git directory)
    dot_git = os.path.join(path, ".git")
    if os.path.isfile(dot_git):
        gs.worktree = True

    output = run_args(["git", "-C", path, "status", "--porcelain=v2", "--branch"])
    for line in output.splitlines():
        if line.startswith("# branch.head "):
            head = line[len("# branch.head "):]
            if head == "(detached)":
                gs.detached = True
                # Get short SHA for detached HEAD
                sha = run_args(["git", "-C", path, "rev-parse", "--short", "HEAD"])
                gs.branch = sha or "HEAD"
            else:
                gs.branch = head or "HEAD"
        elif line.startswith("# branch.ab "):
            match = re.match(r'# branch\.ab \+(\d+) -(\d+)', line)
            if match:
                gs.ahead = int(match.group(1))
                gs.behind = int(match.group(2))
                gs.has_remote = True
        elif line.startswith("u "):
            # Unmerged entry — conflict
            gs.conflicts += 1
            gs.dirty += 1
        elif line.startswith("? "):
            gs.untracked += 1
            gs.dirty += 1
        elif line.startswith("1 ") or line.startswith("2 "):
            # Ordinary or rename/copy entry: "1 XY ..." or "2 XY ..."
            gs.dirty += 1
            xy = line.split()[1] if len(line.split()) > 1 else ".."
            x, y = (xy[0], xy[1]) if len(xy) >= 2 else (".", ".")
            if x != ".":
                gs.staged += 1
            if y != ".":
                gs.modified += 1

    if gs.ahead == 0 and gs.behind == 0:
        has_ab = any(l.startswith("# branch.ab ") for l in output.splitlines())
        if not has_ab:
            gs.has_remote = False

    if not gs.branch:
        gs.branch = "HEAD"

    # Detect special git states via sentinel files
    git_dir = path + "/.git"
    if gs.worktree:
        # Read the gitdir path from the .git file
        try:
            with open(dot_git) as f:
                content = f.read().strip()
                if content.startswith("gitdir: "):
                    git_dir = content[8:]
        except OSError:
            pass

    if os.path.isdir(os.path.join(git_dir, "rebase-merge")) or os.path.isdir(os.path.join(git_dir, "rebase-apply")):
        gs.special_state = "REBASE"
    elif os.path.isfile(os.path.join(git_dir, "MERGE_HEAD")):
        gs.special_state = "MERGE"
    elif os.path.isfile(os.path.join(git_dir, "CHERRY_PICK_HEAD")):
        gs.special_state = "CHERRY-PICK"
    elif os.path.isfile(os.path.join(git_dir, "BISECT_LOG")):
        gs.special_state = "BISECT"

    # Last commit age
    ts = run_args(["git", "-C", path, "log", "-1", "--format=%ct"])
    if ts and ts.isdigit():
        gs.last_commit_age_secs = int(time.time()) - int(ts)

    # Stash count
    stash_out = run_args(["git", "-C", path, "stash", "list", "--oneline"])
    gs.stashes = len(stash_out.splitlines()) if stash_out else 0

    return gs


