# ── SF Symbols ────────────────────────────────────────────────────────────────

def sf_symbol(name, color=None, size=13.0):
    """Load an SF Symbol image, optionally tinted."""
    img = NSImage.imageWithSystemSymbolName_accessibilityDescription_(name, None)
    if img is None:
        return None
    # Apply a point size config
    config = NSImageSymbolConfiguration.configurationWithPointSize_weight_(size, 0)  # 0 = regular
    img = img.imageWithSymbolConfiguration_(config)
    if color:
        config_color = NSImageSymbolConfiguration.configurationPreferringHierarchical()
        img = img.imageWithSymbolConfiguration_(config_color)
        img.setTemplate_(False)
        # For tinting, we create a config with the palette
        try:
            palette_config = NSImageSymbolConfiguration.configurationWithPaletteColors_([color])
            img = img.imageWithSymbolConfiguration_(palette_config)
        except Exception:
            img.setTemplate_(True)
    return img


# ── Rich Text Builder ─────────────────────────────────────────────────────────

def rich_text(segments, base_font=None):
    """Build an NSMutableAttributedString from a list of (text, font, color) tuples."""
    if base_font is None:
        base_font = MONO_SM
    result = NSMutableAttributedString.alloc().init()
    for text, font, color in segments:
        if font is None:
            font = base_font
        if color is None:
            color = CLR_LABEL
        attrs = NSDictionary.dictionaryWithObjects_forKeys_(
            [font, color],
            [NSFontAttributeName, NSForegroundColorAttributeName],
        )
        part = NSAttributedString.alloc().initWithString_attributes_(text, attrs)
        result.appendAttributedString_(part)
    return result


def make_item(attr_string, indent=0, action=None, target=None, tag=0, image=None, tooltip=None):
    """Create an NSMenuItem with rich attributed text, optional SF Symbol, tooltip."""
    if action:
        item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_("", action, "")
        if target:
            item.setTarget_(target)
    else:
        item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_("", None, "")
    item.setAttributedTitle_(attr_string)
    item.setIndentationLevel_(indent)
    item.setTag_(tag)
    if image:
        item.setImage_(image)
    if tooltip:
        item.setToolTip_(tooltip)
    return item


