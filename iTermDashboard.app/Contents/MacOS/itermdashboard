# ── Data Classes ──────────────────────────────────────────────────────────────

@dataclass
class Session:
    window_id: int
    window_name: str
    session_id: str
    session_name: str
    tty: str
    profile: str
    columns: int
    rows: int
    bounds: tuple
    pid: int = 0
    cwd: str = ""
    processes: list = field(default_factory=list)
    uptime: str = ""
    mem_kb: int = 0
    cpu: float = 0.0
    is_claude: bool = False
    running_command: str = ""
    # Foreground command inference
    fg_command: str = ""
    fg_args: str = ""
    # Session role classification
    role: str = "shell"  # shell|editor|agent|build|test|logs|remote|server
    # Activity state
    activity_state: str = "active"  # active|idle|stale|zombie
    idle_secs: int = 0
    # Remote/prod detection
    remote_type: str = ""  # ssh|kubectl|docker|psql|mysql|mosh|et
    remote_target: str = ""
    is_production: bool = False
    # Source app for raise-to-front
    app_source: str = "iTerm2"  # "iTerm2" or "Nexus"


@dataclass
class GitStatus:
    branch: str = ""
    dirty: int = 0
    staged: int = 0
    modified: int = 0
    untracked: int = 0
    conflicts: int = 0
    stashes: int = 0
    ahead: int = 0
    behind: int = 0
    has_remote: bool = True
    is_git: bool = False
    detached: bool = False
    special_state: str = ""  # rebase|merge|cherry-pick|bisect
    last_commit_age_secs: int = 0
    worktree: bool = False


@dataclass
class RefreshSnapshot:
    """Minimal snapshot for computing deltas between refreshes."""
    session_ids: set = field(default_factory=set)
    project_paths: set = field(default_factory=set)
    project_branches: dict = field(default_factory=dict)  # path -> branch
    project_dirty: dict = field(default_factory=dict)  # path -> dirty count
    total_claude: int = 0
    total_claude_mem_kb: int = 0


# ── Subprocess helpers ────────────────────────────────────────────────────────

def run_args(args, timeout=10):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.stdout.strip()
    except Exception:
        return ""


def run_osascript(script, timeout=15):
    try:
        r = subprocess.run(
            ["osascript"],
            input=script, capture_output=True, text=True, timeout=timeout,
        )
        return r.stdout.strip()
    except Exception:
        return ""


