# ── Dev VM CLI ────────────────────────────────────────────────────────────────

DEV_VM_CLI = os.path.expanduser("~/Desktop/ml_made_fun/dev-vm")


def _devvm_cmd(*args, vm=None, timeout=5):
    """Call dev-vm CLI with --json, return parsed dict or None on failure."""
    if not os.path.isfile(DEV_VM_CLI):
        return None
    cmd = [DEV_VM_CLI, "--json"]
    if vm:
        cmd += ["--vm", vm]
    cmd += list(args)
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if r.returncode != 0:
            return None
        return json.loads(r.stdout)
    except Exception:
        return None


def get_devvm_info():
    """Collect dev VM status and ET sessions. Returns list of DevVmInfo."""
    vms_data = _devvm_cmd("list", timeout=10)
    if not vms_data or not vms_data.get("instances"):
        return []

    results = []
    username = os.environ.get("USER", "")
    for inst in vms_data["instances"]:
        vm_name_tag = inst.get("name", "")
        # Extract vm_name from EC2 tag: "dev-vm-kevin" -> "default", "dev-vm-kevin-foo" -> "foo"
        # Strip "dev-vm-{username}" prefix, remainder after "-" is the vm name
        base_prefix = f"dev-vm-{username}"
        if vm_name_tag == base_prefix:
            vm_name = "default"
        elif vm_name_tag.startswith(base_prefix + "-"):
            vm_name = vm_name_tag[len(base_prefix) + 1:]
        else:
            # Not our VM (different user) — skip
            continue

        info = DevVmInfo(
            vm_name=vm_name,
            instance_id=inst.get("instance_id", ""),
            instance_type=inst.get("instance_type", ""),
            state=inst.get("state", ""),
            ip=inst.get("ip") or "",
        )

        # Fetch ET sessions for running VMs
        if info.state == "running" and info.ip:
            sess_data = _devvm_cmd("et", "--list", vm=vm_name if vm_name != "default" else None, timeout=15)
            if sess_data and sess_data.get("sessions"):
                for s in sess_data["sessions"]:
                    info.sessions.append(DevVmSession(
                        name=s.get("name", ""),
                        status=s.get("status", ""),
                        clients=s.get("clients", 0),
                        created_at=s.get("created_at", ""),
                        last_connected=s.get("last_connected", ""),
                        connect_count=s.get("connect_count", 0),
                        on_remote=s.get("on_remote", False),
                    ))

        results.append(info)
    return results


def _extract_et_session_name(full_cmd):
    """Extract the dev-vm ET session name from a local et process command line.

    The et command has -c "B64=<base64> bash -lc '...'" where the base64 decodes
    to a script containing SESSION="<name>" near the top.
    """
    m = re.search(r'B64=(\S+)', full_cmd)
    if not m:
        return None
    b64_val = m.group(1)
    # Strip surrounding quotes if present
    b64_val = b64_val.strip("'\"")
    try:
        decoded = base64.b64decode(b64_val).decode("utf-8", errors="replace")
    except Exception:
        return None
    sm = re.search(r'SESSION="([^"]+)"', decoded)
    return sm.group(1) if sm else None


